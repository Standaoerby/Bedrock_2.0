#:import Window kivy.core.window.Window

<ThemedLabel@Label>:
    font_name: app.font_name
    color: app.theme_config.get("font_color", (1,1,1,1))

# Добавляем кастомный класс для кнопки меню
<MenuButton@Button>:
    background_normal: app.theme_config["menu_button_normal"]
    background_down: app.theme_config.get("menu_button_active", app.theme_config["menu_button_normal"])
    color: app.theme_config.get("menu_selected_color", (1,1,1,1)) if self.screen_name == app.current_screen else app.theme_config.get("menu_unselected_color", (0.7,0.7,0.7,1))
    font_name: app.theme_config["font_name"]
    font_size: str(app.theme_config.get("menu_button_font_size", 30)) + "sp"
    size_hint_x: None
    size_hint_y: None
    width: app.theme_config.get("menu_button_size", [192,64])[0]
    height: app.theme_config.get("menu_button_size", [192,64])[1]
    padding: app.theme_config.get("menu_button_padding", [0,0,0,0])
    screen_name: ""
    on_release:
        app.root.ids.screen_manager.current = self.screen_name

FloatLayout:
    # Контейнер для всех экранов (во весь экран)
    MDScreenManager:
        id: screen_manager
        pos_hint: {"x": 0, "y": 0}
        size_hint: 1, 1  # Изменено на весь экран
        HomeScreen:
            name: "home"
        AlarmScreen:
            name: "alarm"
        ScheduleScreen:
            name: "schedule"
        WeatherScreen:
            name: "weather"
        PigsScreen:
            name: "pigs"

    # Меню (прозрачный контейнер поверх всего)
    BoxLayout:
        orientation: "horizontal"
        size_hint: (1, None)
        height: app.theme_config.get("menu_button_size", [220,70])[1] + 16
        pos_hint: {"top": 1}  # Помещаем вверху экрана
        spacing: "16dp"
        padding: "24dp", "8dp", "24dp", "8dp"
        # Контейнер полностью прозрачный, без canvas.before
        MenuButton:
            text: "Главная"
            screen_name: "home"
        MenuButton:
            text: "Будильник"
            screen_name: "alarm"
        MenuButton:
            text: "Расписание"
            screen_name: "schedule"
        MenuButton:
            text: "Погода"
            screen_name: "weather"
        MenuButton:
            text: "Свинки"
            screen_name: "pigs"


<HomeScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: debug_marker
            text: "debug_marker"
            font_size: "1sp"

        ThemedLabel:
            id: clock_label
            text: "00:00"
            font_size: "200sp"
            color: 1, 1, 1, 1
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

<AlarmScreen>:
    FloatLayout:
        size_hint_y: 1      
        
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("alarm")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: alarms_label
            text: "Загрузка будильников..."
            color: 1, 1, 1, 1
            font_size: "24sp"
            halign: "left"
            valign: "top"
            pos_hint: {"x": 0.05, "top": 0.9}
<WeatherScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("weather")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: weather_label
            text: "Погода..."
            font_size: "32sp"
            halign: "center"
            valign: "top"
            color: 1, 1, 1, 1
            pos_hint: {"center_x": 0.5, "top": 0.85}
<ScheduleScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("schedule")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
    BoxLayout:
        orientation: "vertical"
        # Верхний слой: today + tomorrow
        BoxLayout:
            orientation: "horizontal"
            padding: "32dp"
            spacing: "32dp"

            # Сегодня
            BoxLayout:
                orientation: "vertical"
                ThemedLabel:
                    text: "Сегодня"
                    font_size: "18sp"
                    bold: True
                    color: 1, 1, 0.7, 1
                ThemedLabel:
                    id: today_label
                    text: "..."
                    font_size: "16sp"
                    halign: "left"
                    valign: "top"
                    color: 1, 1, 1, 1

            # Завтра
            BoxLayout:
                orientation: "vertical"
                ThemedLabel:
                    text: "Завтра"
                    font_size: "18sp"
                    bold: True
                    color: 0.8, 1, 1, 1
                ThemedLabel:
                    id: tomorrow_label
                    text: "..."
                    font_size: "16sp"
                    halign: "left"
                    valign: "top"
                    color: 1, 1, 1, 1

        # Кнопка "Вся неделя" или "Назад к сегодня"
        ThemedLabel:
            id: week_button
            text: "Вся неделя"
            font_size: "22sp"
            color: 0.5, 1, 0.5, 1
            halign: "center"
            valign: "middle"
            size_hint_y: None
            height: "48dp"
            on_touch_down:
                if self.collide_point(*args[1].pos): root.toggle_week_mode()

        # Если week_mode — вывод всей недели (скрывает today/tomorrow, показывает week)
        ThemedLabel:
            id: week_label
            text: ""
            font_size: "18sp"
            halign: "left"
            valign: "top"
            color: 1, 1, 1, 1
            opacity: 0  # Скрыто по умолчанию
<PigsScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("pigs")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"
        ThemedLabel:
            text: "Ферма свинок"
            font_size: "32sp"
            halign: "center"
            color: 1, 1, 0.7, 1

        # Вода
        BoxLayout:
            spacing: "12dp"
            ThemedLabel:
                text: "Вода"
                font_size: "20sp"
                size_hint_x: 0.2
            ProgressBar:
                id: water_bar
                max: 1
                value: 0.9
                size_hint_x: 0.6
            Button:
                text: "Дать воды"
                font_name: app.theme_config["font_name"]
                on_release: root.reset_bar("water")

        # Еда
        BoxLayout:
            spacing: "12dp"
            ThemedLabel:
                text: "Еда"
                font_size: "20sp"
                size_hint_x: 0.2
            ProgressBar:
                id: food_bar
                max: 1
                value: 0.8
                size_hint_x: 0.6
            Button:
                text: "Покормить"
                font_name: app.theme_config["font_name"]
                on_release: root.reset_bar("food")

        # Очистка
        BoxLayout:
            spacing: "12dp"
            ThemedLabel:
                text: "Очистка"
                font_size: "20sp"
                size_hint_x: 0.2
            ProgressBar:
                id: clean_bar
                max: 1
                value: 0.7
                size_hint_x: 0.6
            Button:
                text: "Убрать"
                font_name: app.theme_config["font_name"]
                on_release: root.reset_bar("clean")

        ThemedLabel:
            id: pigs_status_label
            text: "Статус: ???"
            font_size: "24sp"
            halign: "center"
            color: 1, 1, 1, 1