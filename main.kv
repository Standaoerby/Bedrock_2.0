#:import Window kivy.core.window.Window
#:import MarqueeLabel classes.marquee.MarqueeLabel

#:include pages/home.kv
#:include pages/alarm.kv
#:include pages/schedule.kv
#:include pages/weather.kv
#:include pages/pigs.kv
#:include pages/settings.kv

<ThemedLabel@Label>:
    font_name: app.theme_config.get("font_name", "Minecraftia")
    color: app.theme_config.get("font_color", [1, 1, 1, 1])
    font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
    # Принудительное обновление при изменении темы
    on_parent: 
        self.color = app.theme_config.get("font_color", [1, 1, 1, 1])
        self.font_name = app.theme_config.get("font_name", "Minecraftia")

<MenuButton@Button>:
    background_normal: app.theme_config.get("menu_button_normal", "")
    background_down: app.theme_config.get("menu_button_active", app.theme_config.get("menu_button_normal", ""))
    color: app.theme_config.get("menu_selected_color", [1, 1, 1, 1]) if self.screen_name == app.current_screen else app.theme_config.get("menu_unselected_color", [0.7, 0.7, 0.7, 1])
    font_name: app.theme_config.get("font_name", "Minecraftia")
    font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
    size_hint_x: None
    size_hint_y: None
    width: app.scale_size(app.theme_config.get("menu_button_size", [180,60])[0])
    height: app.scale_size(app.theme_config.get("menu_button_size", [180,60])[1])
    padding: [0, 0, 0, 0]
    screen_name: ""
    on_press: 
        app.play_sound("click")
        app.menu_navigation = True
    on_release:
        app.root.ids.screen_manager.current = self.screen_name
    # Принудительное обновление фона при изменении темы
    on_parent:
        if self.parent: self.background_normal = app.theme_config.get("menu_button_normal", "")

<ThemedButton@Button>:
    background_normal: app.theme_config.get("button_normal", "atlas://data/images/defaulttheme/button")
    background_down: app.theme_config.get("button_active", "atlas://data/images/defaulttheme/button_pressed")
    font_name: app.theme_config.get("font_name", "Minecraftia")
    font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
    size_hint_y: None
    height: app.ui_metrics['widget_height']
    on_press: app.play_sound("click")
    # Принудительное обновление фона при изменении темы
    on_parent:
        if self.parent: self.background_normal = app.theme_config.get("button_normal", "atlas://data/images/defaulttheme/button")

<ThemedPanel@BoxLayout>:
    canvas.before:
        Color:
            # DYNAMIC panel background based on theme with forced update
            rgba: app.theme_config.get("panel_bg", [0, 0, 0, 0.08])
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [app.theme_config.get("panel_radius", 16)]
    # Принудительное обновление canvas при изменении темы или размера
    on_parent: 
        self.canvas.ask_update()
    on_size: 
        self.canvas.ask_update()
    on_pos: 
        self.canvas.ask_update()

# Main layout - FloatLayout for background, menu and content
FloatLayout:
    # Application background with dynamic update
    Image:
        id: background_image
        source: app.theme_config.get("background_image", "")
        size_hint: 1, 1
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        # Принудительное обновление фона при изменении темы
        on_parent:
            if self.parent: self.source = app.theme_config.get("background_image", "")
    
    # Vertical layout for menu and content
    BoxLayout:
        orientation: 'vertical'
        size_hint: 1, 1
        
        # Menu at the top with fixed height
        BoxLayout:
            id: menu_container
            orientation: 'horizontal'
            size_hint_y: None
            height: app.ui_metrics['menu_height'] + app.ui_metrics['menu_padding'] * 2
            padding: app.ui_metrics['menu_padding']
            
            # Center and limit menu width
            AnchorLayout:
                anchor_x: 'center'
                anchor_y: 'center'
                
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint: None, None
                    width: min(1024 - app.ui_metrics['menu_padding'] * 2, Window.width - app.ui_metrics['menu_padding'] * 2)
                    height: app.ui_metrics['menu_height']
                    spacing: app.ui_metrics['widget_spacing']
                    
                    MenuButton:
                        text: "Home"
                        screen_name: "home"
                    MenuButton:
                        text: "Alarm"
                        screen_name: "alarm"
                    MenuButton:
                        text: "School"
                        screen_name: "schedule"
                    MenuButton:
                        text: "Climate"
                        screen_name: "weather"
                    MenuButton:
                        text: "Pigs"
                        screen_name: "pigs"
                    MenuButton:
                        text: ">"
                        screen_name: "settings"
                        size_hint_x: None
                        width: app.scale_size(60)
        
        # Content (screens) takes remaining space
        MDScreenManager:
            id: screen_manager
            HomeScreen:
                name: "home"
            AlarmScreen:
                name: "alarm"
            ScheduleScreen:
                name: "schedule"
            WeatherScreen:
                name: "weather"
            PigsScreen:
                name: "pigs"
            SettingsScreen:
                name: "settings"