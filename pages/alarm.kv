<AlarmScreen>:
    page_key: "alarm"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            source: app.get_overlay_image("alarm")

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.92, 0.85
            pos_hint: {"center_x": 0.5, "center_y": 0.48}
            spacing: "12dp"

            # Section 1: Time + Active toggle
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "120dp"
                spacing: "12dp"

                ThemedLabel:
                    text: "Time"
                    size_role: "medium"
                    color_role: "font_default"
                    size_hint_x: 0.12
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Hours +/- digit
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.12

                    ThemedButton:
                        text: "+"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.increment_hour()

                    ThemedButton:
                        text: "-"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.decrement_hour()

                ThemedLabel:
                    id: hour_label
                    text: root.alarm_time.split(':')[0]
                    size_role: "huge"
                    color_role: "font_default"
                    size_hint_x: 0.18
                    halign: "center"
                    valign: "middle"
                    font_size: "72sp"

                ThemedLabel:
                    text: ":"
                    size_role: "huge"
                    color_role: "font_default"
                    size_hint_x: 0.04
                    halign: "center"
                    valign: "middle"
                    font_size: "72sp"

                ThemedLabel:
                    id: minute_label
                    text: root.alarm_time.split(':')[1]
                    size_role: "huge"
                    color_role: "font_default"
                    size_hint_x: 0.18
                    halign: "center"
                    valign: "middle"
                    font_size: "72sp"

                # Minutes +/-
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.12

                    ThemedButton:
                        text: "+"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.increment_minute()

                    ThemedButton:
                        text: "-"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.decrement_minute()

                # Active toggle
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 0.24
                    spacing: "4dp"

                    ThemedLabel:
                        text: "Active"
                        size_role: "medium"
                        color_role: "font_default"
                        size_hint_x: 0.6
                        halign: "right"
                        valign: "middle"
                        text_size: self.size

                    CheckBox:
                        id: active_checkbox
                        active: root.alarm_active
                        size_hint_x: 0.4
                        on_press: app.play_sound("click")
                        on_active: root.on_active_toggled(self.active)

            # Section 2: Repeat days
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: "84dp"
                spacing: "6dp"

                ThemedLabel:
                    text: "Repeat on days:"
                    size_role: "medium"
                    color_role: "font_default"
                    size_hint_y: None
                    height: "28dp"
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                GridLayout:
                    cols: 7
                    spacing: "8dp"
                    size_hint_y: None
                    height: "48dp"

                    ToggleButton:
                        id: repeat_mon
                        text: "Mon"
                        state: "down" if "Mon" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Mon", self.state)
                    ToggleButton:
                        id: repeat_tue
                        text: "Tue"
                        state: "down" if "Tue" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Tue", self.state)
                    ToggleButton:
                        id: repeat_wed
                        text: "Wed"
                        state: "down" if "Wed" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Wed", self.state)
                    ToggleButton:
                        id: repeat_thu
                        text: "Thu"
                        state: "down" if "Thu" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Thu", self.state)
                    ToggleButton:
                        id: repeat_fri
                        text: "Fri"
                        state: "down" if "Fri" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Fri", self.state)
                    ToggleButton:
                        id: repeat_sat
                        text: "Sat"
                        state: "down" if "Sat" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Sat", self.state)
                    ToggleButton:
                        id: repeat_sun
                        text: "Sun"
                        state: "down" if "Sun" in root.alarm_repeat else "normal"
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Sun", self.state)

            # Section 3: Ringtone + Play
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "48dp"
                spacing: "10dp"

                ThemedLabel:
                    text: "Ringtone:"
                    size_role: "medium"
                    color_role: "font_default"
                    size_hint_x: 0.18
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Spinner:
                    id: ringtone_spinner
                    text: root.selected_ringtone
                    values: root.ringtone_list
                    font_name: app.theme_config.get("font_name", "Minecraftia")
                    font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                    size_hint_x: 0.6
                    on_text: root.select_ringtone(self.text)

                ToggleButton:
                    id: play_button
                    text: "Play"
                    font_name: app.theme_config.get("font_name", "Minecraftia")
                    font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                    size_hint_x: 0.22
                    on_state: root.toggle_play_ringtone(self.state)

            # Section 4: Fade-in
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "40dp"
                spacing: "10dp"

                Widget:
                    size_hint_x: 0.3

                CheckBox:
                    id: fadein_checkbox
                    active: root.alarm_fadein
                    size_hint_x: None
                    width: "32dp"
                    on_press: app.play_sound("click")
                    on_active: root.on_fadein_toggled(self.active)

                ThemedLabel:
                    text: "Fade-in volume"
                    size_role: "medium"
                    color_role: "font_default"
                    size_hint_x: 0.4
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Widget:
                    size_hint_x: 0.3

            # Section 5: Save
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: "48dp"

                ThemedButton:
                    text: "Save"
                    size_role: "large"
                    color_role: "font_default"
                    size_hint: 0.3, None
                    height: "44dp"
                    on_press: app.play_sound("click")
                    on_release: root.save_alarm()
