<PigsScreen>:
    page_key: "pigs"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            source: app.get_overlay_image("pigs")

        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.9, 0.78
            pos_hint: {"center_x": 0.5, "center_y": 0.48}
            spacing: "20dp"

            # Left panel — 3 sections (Water/Food/Cleaning)
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.5
                padding: "16dp"
                spacing: "20dp"

                # Water section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: "8dp"

                    ThemedLabel:
                        text: "Water"
                        size_role: "large"
                        color_role: "font_default"
                        size_hint_y: None
                        height: "32dp"
                        halign: "left"
                        text_size: self.size
                        valign: "middle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: "12dp"

                        CustomProgressBar:
                            id: water_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: "30dp"
                            bar_color: app.theme_config.get("colors", {}).get("bar_water", [0, 0.6, 0.8, 0.8])

                        ThemedButton:
                            text: "Done"
                            size_role: "medium"
                            color_role: "font_default"
                            size_hint_x: 0.35
                            size_hint_y: None
                            height: "40dp"
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("water")

                # Food section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: "8dp"

                    ThemedLabel:
                        text: "Food"
                        size_role: "large"
                        color_role: "font_default"
                        size_hint_y: None
                        height: "32dp"
                        halign: "left"
                        text_size: self.size
                        valign: "middle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: "12dp"

                        CustomProgressBar:
                            id: food_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: "30dp"
                            bar_color: app.theme_config.get("colors", {}).get("bar_food", [0.8, 0.4, 0, 0.8])

                        ThemedButton:
                            text: "Done"
                            size_role: "medium"
                            color_role: "font_default"
                            size_hint_x: 0.35
                            size_hint_y: None
                            height: "40dp"
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("food")

                # Cleaning section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: "8dp"

                    ThemedLabel:
                        text: "Cleaning"
                        size_role: "large"
                        color_role: "font_default"
                        size_hint_y: None
                        height: "32dp"
                        halign: "left"
                        text_size: self.size
                        valign: "middle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: "12dp"

                        CustomProgressBar:
                            id: clean_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: "30dp"
                            bar_color: app.theme_config.get("colors", {}).get("bar_clean", [0, 0.8, 0.2, 0.8])

                        ThemedButton:
                            text: "Done"
                            size_role: "medium"
                            color_role: "font_default"
                            size_hint_x: 0.35
                            size_hint_y: None
                            height: "40dp"
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("clean")

            # Right panel — pig portrait
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.5
                padding: "12dp"

                Image:
                    id: pigs_image
                    source: "assets/images/pigs_1.png"
                    size_hint: 1, 1
                    fit_mode: 'contain'
