<SettingsScreen>:
    page_key: "settings"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            page_key: "settings"

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.85, None
            height: self.minimum_height
            pos_hint: {"center_x": 0.5, "top": 0.98}
            padding: app.ui_metrics["padding_xs"]
            spacing: app.ui_metrics["spacing_md"]

            # Theme + dark mode
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: 2 * app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Theme:"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedSpinner:
                        id: theme_spinner
                        text: root.current_theme
                        values: root.available_themes
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.7
                        on_text: root.change_theme(self.text)

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Dark Mode" if root.dark_mode_available else "Dark Mode (not available)"
                        size_role: "field_label"
                        color: app.theme_config.get("colors", {}).get("font_default", [1, 1, 1, 1]) if root.dark_mode_available else app.theme_config.get("colors", {}).get("font_disabled", [0.6, 0.6, 0.6, 1])
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.6

                    CheckBox:
                        id: dark_mode_checkbox
                        active: root.dark_mode_enabled
                        disabled: not root.dark_mode_available
                        size_hint_x: 0.4
                        on_active: root.toggle_dark_mode(self.active)

            # User panel
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: 2 * app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Username:"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedTextInput:
                        id: username_input
                        text: root.username
                        size_role: "field_label"
                        size_hint_x: 0.7
                        multiline: False

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Birth Date:"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.7
                        spacing: app.ui_metrics["spacing_xs"]

                        ThemedTextInput:
                            id: birth_day
                            text: root.birth_day
                            size_role: "field_label"
                            size_hint_x: 0.22
                            multiline: False
                            input_filter: "int"

                        ThemedLabel:
                            text: "/"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.05
                            halign: "center"

                        ThemedTextInput:
                            id: birth_month
                            text: root.birth_month
                            size_role: "field_label"
                            size_hint_x: 0.22
                            multiline: False
                            input_filter: "int"

                        ThemedLabel:
                            text: "/"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.05
                            halign: "center"

                        ThemedTextInput:
                            id: birth_year
                            text: root.birth_year
                            size_role: "field_label"
                            size_hint_x: 0.3
                            multiline: False
                            input_filter: "int"

            # Save button
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: app.ui_metrics["widget_height_lg"]

                ThemedButton:
                    text: "Save Settings"
                    size_role: "large"
                    color_role: "font_default"
                    size_hint: 0.4, None
                    height: app.ui_metrics["widget_height_md"]
                    on_press: app.play_sound("click")
                    on_release: root.save_all_settings()
