<SettingsScreen>:
    page_key: "settings"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            source: app.get_overlay_image("settings")

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.85, 0.78
            pos_hint: {"center_x": 0.5, "center_y": 0.48}
            spacing: "16dp"

            # Theme + dark mode
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: "120dp"
                padding: "12dp"

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "50dp"
                    spacing: "10dp"

                    ThemedLabel:
                        text: "Theme:"
                        size_role: "medium"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    Spinner:
                        id: theme_spinner
                        text: root.current_theme
                        values: root.available_themes
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        size_hint_x: 0.7
                        on_text: root.change_theme(self.text)

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "50dp"
                    spacing: "10dp"

                    ThemedLabel:
                        text: "Dark Mode" if root.dark_mode_available else "Dark Mode (not available)"
                        size_role: "medium"
                        color: app.theme_config.get("colors", {}).get("font_default", [1, 1, 1, 1]) if root.dark_mode_available else app.theme_config.get("colors", {}).get("font_disabled", [0.6, 0.6, 0.6, 1])
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.6

                    CheckBox:
                        id: dark_mode_checkbox
                        active: root.dark_mode_enabled
                        disabled: not root.dark_mode_available
                        size_hint_x: 0.4
                        on_active: root.toggle_dark_mode(self.active)

            # User panel
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: "110dp"
                padding: "12dp"

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "40dp"
                    spacing: "10dp"

                    ThemedLabel:
                        text: "Username:"
                        size_role: "medium"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    TextInput:
                        id: username_input
                        text: root.username
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        size_hint_x: 0.7
                        multiline: False

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "40dp"
                    spacing: "10dp"

                    ThemedLabel:
                        text: "Birth Date:"
                        size_role: "medium"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.7
                        spacing: "5dp"

                        TextInput:
                            id: birth_day
                            text: root.birth_day
                            font_name: app.theme_config.get("font_name", "Minecraftia")
                            font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                            size_hint_x: 0.22
                            multiline: False
                            input_filter: "int"

                        ThemedLabel:
                            text: "/"
                            size_role: "medium"
                            color_role: "font_default"
                            size_hint_x: 0.05
                            halign: "center"

                        TextInput:
                            id: birth_month
                            text: root.birth_month
                            font_name: app.theme_config.get("font_name", "Minecraftia")
                            font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                            size_hint_x: 0.22
                            multiline: False
                            input_filter: "int"

                        ThemedLabel:
                            text: "/"
                            size_role: "medium"
                            color_role: "font_default"
                            size_hint_x: 0.05
                            halign: "center"

                        TextInput:
                            id: birth_year
                            text: root.birth_year
                            font_name: app.theme_config.get("font_name", "Minecraftia")
                            font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                            size_hint_x: 0.3
                            multiline: False
                            input_filter: "int"

            # Save button
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: "60dp"

                ThemedButton:
                    text: "Save Settings"
                    size_role: "large"
                    color_role: "font_default"
                    size_hint: 0.4, None
                    height: "50dp"
                    on_press: app.play_sound("click")
                    on_release: root.save_all_settings()
