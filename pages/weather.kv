<WeatherScreen>:
    page_key: "weather"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            source: app.theme_config.get("overlay_images", {}).get("weather", "")

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.92, 0.78
            pos_hint: {"center_x": 0.5, "center_y": 0.48}
            padding: "12dp"
            spacing: "10dp"

            # Top row: Forecast | Sensors
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: 0.4
                spacing: "12dp"

                ThemedPanel:
                    orientation: "vertical"
                    size_hint_x: 0.5
                    padding: "12dp"
                    spacing: "6dp"

                    ThemedLabel:
                        text: "Weather Forecast"
                        size_role: "large"
                        color_role: "font_highlight"
                        size_hint_y: None
                        height: "32dp"

                    ThemedLabel:
                        id: current_temp
                        text: "0°C"
                        size_role: "xlarge"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: current_condition
                        text: "Weather condition"
                        size_role: "medium"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: current_precipitation
                        text: "Precipitation: 0%"
                        size_role: "small"
                        color_role: "font_secondary"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedButton:
                        text: "Refresh"
                        size_role: "medium"
                        color_role: "font_default"
                        size_hint_y: None
                        height: "40dp"
                        on_press: app.play_sound("click")
                        on_release: root.update_weather()

                ThemedPanel:
                    orientation: "vertical"
                    size_hint_x: 0.5
                    padding: "12dp"
                    spacing: "4dp"

                    ThemedLabel:
                        text: "Room Sensors"
                        size_role: "large"
                        color_role: "font_highlight"
                        size_hint_y: None
                        height: "32dp"

                    ThemedLabel:
                        id: sensor_temp
                        text: "Temperature: 0°C"
                        size_role: "small"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_humidity
                        text: "Humidity: 0%"
                        size_role: "small"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_co2
                        text: "CO2: 0 ppm"
                        size_role: "small"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_tvoc
                        text: "TVOC: 0 ppb"
                        size_role: "small"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: air_quality
                        text: "Air Quality: Unknown"
                        size_role: "small"
                        color_role: "font_default"
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

            # Bottom: Weekly forecast
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: 0.6
                padding: "12dp"
                spacing: "6dp"

                ThemedLabel:
                    text: "Weekly Forecast"
                    size_role: "large"
                    color_role: "font_highlight"
                    size_hint_y: None
                    height: "32dp"

                GridLayout:
                    id: weekly_forecast_container
                    cols: 1
                    spacing: "4dp"
                    size_hint_y: 1
