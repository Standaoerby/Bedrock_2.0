<ThemedLabel@Label>:
    font_name: app.font_name

BoxLayout:
    orientation: "vertical"

    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "64dp"
        padding: "8dp"
        spacing: "32dp"
        canvas.before:
            Color:
                rgba: 0.8, 0.8, 0.8, 1
            Rectangle:
                size: self.size
                pos: self.pos

        ThemedLabel:
            text: "HOME"
            color: app.theme_config["menu_selected_color"] if app.current_screen == "home" else app.theme_config["menu_unselected_color"]
            font_size: "22sp"
            size_hint_x: None
            width: "120dp"
            halign: "center"
            valign: "middle"
            on_touch_down:
                if self.collide_point(*args[1].pos): app.root.ids.screen_manager.current = "home"

        ThemedLabel:
            text: "ALARM"
            color: app.theme_config["menu_selected_color"] if app.current_screen == "alarm" else app.theme_config["menu_unselected_color"]
            font_size: "22sp"
            size_hint_x: None
            width: "120dp"
            halign: "center"
            valign: "middle"
            on_touch_down:
                if self.collide_point(*args[1].pos): app.root.ids.screen_manager.current = "alarm"
        ThemedLabel:
            text: "WEATHER"
            color: app.theme_config["menu_selected_color"] if app.current_screen == "weather" else app.theme_config["menu_unselected_color"]
            font_size: "22sp"
            size_hint_x: None
            width: "120dp"
            halign: "center"
            valign: "middle"
            on_touch_down:
                if self.collide_point(*args[1].pos): app.root.ids.screen_manager.current = "weather"


    # Экраны — как всегда
    MDScreenManager:
        id: screen_manager

        HomeScreen:
            name: "home"
        AlarmScreen:
            name: "alarm"
        WeatherScreen:
            name: "weather"

<HomeScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: debug_marker
            text: "debug_marker"
            font_size: "1sp"

        ThemedLabel:
            id: clock_label
            text: "00:00"
            font_size: "96sp"
            color: 1, 1, 1, 1
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

<AlarmScreen>:
    FloatLayout:
        size_hint_y: 1      
        
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("alarm")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: alarms_label
            text: "Загрузка будильников..."
            color: 1, 1, 1, 1
            font_size: "24sp"
            halign: "left"
            valign: "top"
            pos_hint: {"x": 0.05, "top": 0.9}
<WeatherScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("weather")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: weather_label
            text: "Погода..."
            font_size: "32sp"
            halign: "center"
            valign: "top"
            color: 1, 1, 1, 1
            pos_hint: {"center_x": 0.5, "top": 0.85}
