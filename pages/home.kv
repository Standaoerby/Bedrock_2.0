#:import MarqueeLabel classes.marquee.MarqueeLabel

<HomeScreen>:
    FloatLayout:
        size_hint: 1, 1
        # Background and overlay images
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: app.theme_config.get("overlay_opacity", 0.5)
            
        # Current date and day of week (top left) - smaller font
        ThemedPanel:
            orientation: "vertical"
            size_hint: 0.38, None
            height: app.theme_config.get("grid_unit_2x", "64dp")
            pos_hint: {"x": 0.05, "top": 0.88}
            padding: app.theme_config.get("grid_unit_quarter", "8dp")
            
            ThemedLabel:
                id: date_label
                text: root.current_date
                font_size: app.theme_config.get("font_sizes", {}).get("small", "16sp")  # Smaller font
                halign: "left"
                
            ThemedLabel:
                id: day_label
                text: root.current_day
                font_size: app.theme_config.get("font_sizes", {}).get("small", "16sp")  # Smaller font
                halign: "left"

        # Alarm widget (top right) - with padding and larger time digits
        ThemedPanel:
            orientation: "horizontal"
            size_hint: 0.42, None
            height: app.theme_config.get("grid_unit_2x", "64dp")
            pos_hint: {"right": 0.95, "top": 0.88}
            spacing: app.theme_config.get("grid_unit_quarter", "8dp")
            padding: [app.theme_config.get("grid_unit_half", "16dp"), 0, 0, 0]  # Added left padding
            
            ThemedLabel:
                text: "Alarm:"
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
                size_hint_x: 0.25
                
            ThemedLabel:
                id: alarm_time_label
                text: root.current_alarm_time
                font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")  # Larger font for time
                size_hint_x: 0.45
                color: app.theme_config.get("colors", {}).get("semi_active", [0.7, 1, 0.7, 1]) if root.alarm_active else [0.4, 0.4, 0.4, 1]  # Darker when inactive
                
            Button:
                id: alarm_status_button
                text: "ON" if root.alarm_active else "OFF"
                size_hint_x: 0.3
                font_name: app.theme_config["font_name"]
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
                color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
                background_normal: app.theme_config.get("button_normal", "atlas://data/images/defaulttheme/button")
                background_down: app.theme_config.get("button_active", "atlas://data/images/defaulttheme/button_pressed")
                on_release: root.toggle_alarm()

        # Main clock display with proper shadow effect
        # Shadow effect - now properly updates with the main clock
        ThemedLabel:
            id: clock_shadow_label
            text: clock_label.text  # Bind to the main clock's text
            font_size: app.theme_config.get("font_sizes", {}).get("huge", "200sp")
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.51, "center_y": 0.54}  # 5px right and down (approx in normalized coordinates)
            color: [0, 0, 0, 0.5]  # Dark shadow color
            
        ThemedLabel:
            id: clock_label
            text: "00:00"
            font_size: app.theme_config.get("font_sizes", {}).get("huge", "200sp")
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.55}

        # Weather widget - removed "Weather:" label and colorized trend indicators
        ThemedPanel:
            orientation: "vertical"
            size_hint: 0.6, None
            height: app.theme_config.get("grid_unit_2x", "64dp")  # Reduced height since we removed the title
            pos_hint: {"center_x": 0.5, "center_y": 0.25}
            spacing: app.theme_config.get("grid_unit_quarter", "8dp")
            padding: app.theme_config.get("grid_unit_half", "16dp")
            
            BoxLayout:
                orientation: "horizontal"
                spacing: app.theme_config.get("grid_unit_half", "16dp")
                
                # Current temperature & condition
                ThemedLabel:
                    id: weather_now_label
                    text: root.weather_now_str
                    font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")
                    size_hint_x: 0.6
                    halign: "center"
                
                # Forecast temperature with colored trend indicator
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 0.4
                    spacing: app.theme_config.get("grid_unit_quarter", "8dp")
                    
                    ThemedLabel:
                        id: weather_trend_label
                        text: root.weather_trend_arrow
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")
                        size_hint_x: 0.2
                        halign: "center"
                        color: [0, 0.6, 1, 1] if root.weather_trend_arrow == "↓" else ([1, 0.3, 0.3, 1] if root.weather_trend_arrow == "↑" else [1, 1, 1, 1])
                        
                    ThemedLabel:
                        id: weather_forecast_label
                        text: root.weather_5h_str
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
                        size_hint_x: 0.8
                        halign: "left"

        # Notification widget (bottom)
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.8, None
            height: app.theme_config.get("grid_unit_2x", "64dp")
            pos_hint: {"center_x": 0.5, "y": 0.05}
            
            MarqueeLabel:
                id: notification_label
                full_text: root.notification_text
                text: root.notification_text
                font_name: app.theme_config["font_name"]
                color: app.theme_config["font_color"]
                font_size: app.theme_config.get("widget_font_size", "20sp")