<SettingsScreen>:
    page_key: "settings"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            page_key: "settings"

        OverflowColumn:
            size_hint: 0.85, 0.94
            pos_hint: {"center_x": 0.5, "top": 0.98}
            padding: app.ui_metrics["padding_xs"]
            spacing: app.ui_metrics["spacing_md"]

            # Theme picker (dark/light is owned by Auto Theme — no manual toggle here)
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_theme", "Theme") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedSpinner:
                        id: theme_spinner
                        text: root.current_theme
                        values: root.available_themes
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.7
                        on_text: root.change_theme(self.text)

            # Language picker
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_language", "Language") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedSpinner:
                        id: language_spinner
                        text: root.language
                        values: root.available_languages
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.7
                        on_text: root.change_language(self.text)

            # Auto-theme panel — strategy + threshold (LDR-only) + live status.
            # Threshold row collapses to 0px when strategy != ldr (height,
            # opacity, disabled all driven by the strategy property), and
            # the panel itself shrinks accordingly so we don't leave dead
            # space above the status line.
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: (3 if root.auto_theme_strategy == "ldr" else 2) * app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_auto_theme", "Auto Theme") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedSpinner:
                        id: auto_theme_spinner
                        text: root.auto_theme_strategy
                        values: root.auto_theme_strategies
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.7
                        on_text: root.change_auto_theme_strategy(self.text)

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"] if root.auto_theme_strategy == "ldr" else 0
                    spacing: app.ui_metrics["spacing_sm"]
                    disabled: root.auto_theme_strategy != "ldr"
                    opacity: 1 if root.auto_theme_strategy == "ldr" else 0

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_threshold", "Threshold") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedTextInput:
                        id: threshold_input
                        text: str(int(root.light_sensor_threshold))
                        size_role: "field_label"
                        size_hint_x: 0.7
                        multiline: False
                        input_filter: "int"
                        on_text_validate: root.change_threshold(self.text)
                        on_focus: root.change_threshold(self.text) if not self.focus else None

                ThemedLabel:
                    text: root.auto_theme_status
                    size_role: "field_label"
                    color_role: "font_default"
                    halign: "center"
                    valign: "middle"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]

            # Volume panel — system volume via wpctl on Pi (also driven
            # by GPIO 23/24 buttons when those are wired). On Windows the
            # backend is "cache" and changes don't touch system audio.
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_volume", "Volume") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedButton:
                        text: "-"
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.15
                        on_press: app.play_sound("click")
                        on_release: root.volume_down()

                    ThemedLabel:
                        id: volume_value_label
                        text: str(int(root.current_volume)) + "%"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "center"
                        valign: "middle"
                        size_hint_x: 0.4

                    ThemedButton:
                        text: "+"
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.15
                        on_press: app.play_sound("click")
                        on_release: root.volume_up()

            # User panel
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: 2 * app.ui_metrics["widget_height_md"] + 2 * app.ui_metrics["padding_md"]
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_xs"]

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_username", "Username") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    ThemedTextInput:
                        id: username_input
                        text: root.username
                        size_role: "field_label"
                        size_hint_x: 0.7
                        multiline: False

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: app.i18n_strings.get("settings_birthday", "Birthday") + ":"
                        size_role: "field_label"
                        color_role: "font_default"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3

                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.7
                        spacing: app.ui_metrics["spacing_xs"]

                        ThemedTextInput:
                            id: birth_day
                            text: root.birth_day
                            size_role: "field_label"
                            size_hint_x: 0.22
                            multiline: False
                            input_filter: "int"

                        ThemedLabel:
                            text: "/"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.05
                            halign: "center"

                        ThemedTextInput:
                            id: birth_month
                            text: root.birth_month
                            size_role: "field_label"
                            size_hint_x: 0.22
                            multiline: False
                            input_filter: "int"

                        ThemedLabel:
                            text: "/"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.05
                            halign: "center"

                        ThemedTextInput:
                            id: birth_year
                            text: root.birth_year
                            size_role: "field_label"
                            size_hint_x: 0.3
                            multiline: False
                            input_filter: "int"

            # Save button
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: app.ui_metrics["widget_height_lg"]

                ThemedButton:
                    text: app.i18n_strings.get("settings_save", "Save")
                    size_role: "large"
                    color_role: "font_default"
                    size_hint: 0.4, None
                    height: app.ui_metrics["widget_height_md"]
                    on_press: app.play_sound("click")
                    on_release: root.save_all_settings()
