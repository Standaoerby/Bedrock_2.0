#:import Window kivy.core.window.Window

<ThemedLabel@Label>:
    font_name: app.font_name
    color: app.theme_config.get("font_color", (1,1,1,1))

# Добавляем кастомный класс для кнопки меню
<MenuButton@Button>:
    background_normal: app.theme_config["menu_button_normal"]
    background_down: app.theme_config.get("menu_button_active", app.theme_config["menu_button_normal"])
    color: app.theme_config.get("menu_selected_color", (1,1,1,1)) if self.screen_name == app.current_screen else app.theme_config.get("menu_unselected_color", (0.7,0.7,0.7,1))
    font_name: app.theme_config["font_name"]
    font_size: str(app.theme_config.get("menu_button_font_size", 30)) + "sp"
    size_hint_x: None
    size_hint_y: None
    width: app.theme_config.get("menu_button_size", [192,64])[0]
    height: app.theme_config.get("menu_button_size", [192,64])[1]
    padding: app.theme_config.get("menu_button_padding", [0,0,0,0])
    screen_name: ""
    on_release:
        app.root.ids.screen_manager.current = self.screen_name

FloatLayout:
    # Контейнер для всех экранов (во весь экран)
    MDScreenManager:
        id: screen_manager
        pos_hint: {"x": 0, "y": 0}
        size_hint: 1, 1  # Изменено на весь экран
        HomeScreen:
            name: "home"
        AlarmScreen:
            name: "alarm"
        ScheduleScreen:
            name: "schedule"
        WeatherScreen:
            name: "weather"
        PigsScreen:
            name: "pigs"

    # Меню (прозрачный контейнер поверх всего)
    BoxLayout:
        orientation: "horizontal"
        size_hint: (1, None)
        height: app.theme_config.get("menu_button_size", [220,70])[1] + 16
        pos_hint: {"top": 1}  # Помещаем вверху экрана
        spacing: "10dp"
        padding: "15dp", "4dp", "15dp", "4dp"
        # Контейнер полностью прозрачный, без canvas.before
        MenuButton:
            text: "Home"
            screen_name: "home"
        MenuButton:
            text: "Alarm"
            screen_name: "alarm"
        MenuButton:
            text: "School"
            screen_name: "schedule"
        MenuButton:
            text: "Climate"
            screen_name: "weather"
        MenuButton:
            text: "Pigs"
            screen_name: "pigs"


<HomeScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: debug_marker
            text: "debug_marker"
            font_size: "1sp"

        ThemedLabel:
            id: clock_label
            text: "00:00"
            font_size: "200sp"
            color: 1, 1, 1, 1
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
<AlarmScreen>:
    FloatLayout:
        size_hint: 1, 1

        # Фон и оверлей
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("alarm")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5

        # Блок — время + активность
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.65, None
            height: "60dp"
            pos_hint: {"center_x": 0.5, "top": 0.87}
            spacing: "32dp"

            ThemedLabel:
                text: "Time"
                font_size: "22sp"
                size_hint_x: 0.2

            # Новый блок выбора времени с кнопками +/-
            BoxLayout:
                orientation: "horizontal"
                size_hint_x: 0.5
                spacing: "8dp"
                
                # Часы (с кнопками +/-)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.45
                    
                    # Кнопка +
                    Button:
                        text: "+"
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        size_hint_y: 0.4
                        on_release: root.increment_hour()
                    
                    # Значение часов
                    ThemedLabel:
                        id: hour_label
                        text: root.alarm_time.split(':')[0]
                        font_size: "26sp"
                        halign: "center"
                        valign: "center"
                        size_hint_y: 0.4
                    
                    # Кнопка -
                    Button:
                        text: "-"
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        size_hint_y: 0.4
                        on_release: root.decrement_hour()
                
                # Разделитель
                ThemedLabel:
                    text: ":"
                    font_size: "26sp"
                    halign: "center"
                    valign: "center"
                    size_hint_x: 0.1
                
                # Минуты (с кнопками +/-)
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.45
                    
                    # Кнопка +
                    Button:
                        text: "+"
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        size_hint_y: 0.4
                        on_release: root.increment_minute()
                    
                    # Значение минут
                    ThemedLabel:
                        id: minute_label
                        text: root.alarm_time.split(':')[1]
                        font_size: "26sp"
                        halign: "center"
                        valign: "center"
                        size_hint_y: 0.4
                    
                    # Кнопка -
                    Button:
                        text: "-"
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        size_hint_y: 0.4
                        on_release: root.decrement_minute()

            ThemedLabel:
                text: "Active"
                font_size: "22sp"
                size_hint_x: 0.15
            CheckBox:
                id: active_checkbox
                active: root.alarm_active
                size_hint_x: None
                width: "38dp"
                on_active: root.on_active_toggled(self.active)

        # Повтор по дням недели (ToggleButton для каждого дня)
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.85, None
            height: "48dp"
            pos_hint: {"center_x": 0.5, "top": 0.76}
            spacing: "10dp"
            ToggleButton:
                id: repeat_mon
                text: "Mon"
                state: "down" if "Mon" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Mon", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
            ToggleButton:
                id: repeat_tue
                text: "Tue"
                state: "down" if "Tue" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Tue", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
            ToggleButton:
                id: repeat_wed
                text: "Wed"
                state: "down" if "Wed" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Wed", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
            ToggleButton:
                id: repeat_thu
                text: "Thu"
                state: "down" if "Thu" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Thu", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
            ToggleButton:
                id: repeat_fri
                text: "Fri"
                state: "down" if "Fri" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Fri", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
            ToggleButton:
                id: repeat_sat
                text: "Sat"
                state: "down" if "Sat" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Sat", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
            ToggleButton:
                id: repeat_sun
                text: "Sun"
                state: "down" if "Sun" in root.alarm_repeat else "normal"
                on_state: root.toggle_repeat("Sun", self.state)
                font_name: app.theme_config["font_name"]
                font_size: "20sp"

        # Рингтон + Play
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.82, None
            height: "54dp"
            pos_hint: {"center_x": 0.5, "top": 0.67}
            spacing: "18dp"
            Spinner:
                id: ringtone_spinner
                text: root.selected_ringtone
                values: root.ringtone_list
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
                size_hint_x: 0.7
                on_text: root.select_ringtone(self.text)
            Button:
                text: "Play"
                font_name: app.theme_config["font_name"]
                font_size: "20sp"
                size_hint_x: 0.3
                on_release: root.play_ringtone()

        # Fade-in
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.4, None
            height: "44dp"
            pos_hint: {"center_x": 0.5, "top": 0.60}
            spacing: "12dp"
            CheckBox:
                id: fadein_checkbox
                active: root.alarm_fadein
                size_hint_x: None
                width: "36dp"
                on_active: root.on_fadein_toggled(self.active)
            ThemedLabel:
                text: "Fade-in"
                font_size: "20sp"

        # Save button
        Button:
            text: "Save"
            font_name: app.theme_config["font_name"]
            font_size: "22sp"
            size_hint: 0.2, None
            height: "48dp"
            pos_hint: {"center_x": 0.5, "top": 0.52}
            on_release: root.save_alarm()


<WeatherScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("weather")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            id: weather_label
            text: "Погода..."
            font_size: "32sp"
            halign: "center"
            valign: "top"
            color: 1, 1, 1, 1
            pos_hint: {"center_x": 0.5, "top": 0.85}
<ScheduleScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("schedule")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
    BoxLayout:
        orientation: "vertical"
        # Верхний слой: today + tomorrow
        BoxLayout:
            orientation: "horizontal"
            padding: "32dp"
            spacing: "32dp"

            # Сегодня
            BoxLayout:
                orientation: "vertical"
                ThemedLabel:
                    text: "Today"
                    font_size: "18sp"
                    bold: True
                    color: 1, 1, 0.7, 1
                ThemedLabel:
                    id: today_label
                    text: "..."
                    font_size: "16sp"
                    halign: "left"
                    valign: "top"
                    color: 1, 1, 1, 1

            # Завтра
            BoxLayout:
                orientation: "vertical"
                ThemedLabel:
                    text: "Tomorrow"
                    font_size: "18sp"
                    bold: True
                    color: 0.8, 1, 1, 1
                ThemedLabel:
                    id: tomorrow_label
                    text: "..."
                    font_size: "16sp"
                    halign: "left"
                    valign: "top"
                    color: 1, 1, 1, 1

        # Кнопка "Вся неделя" или "Назад к сегодня"
        ThemedLabel:
            id: week_button
            text: "All week"
            font_size: "22sp"
            color: 0.5, 1, 0.5, 1
            halign: "center"
            valign: "middle"
            size_hint_y: None
            height: "48dp"
            on_touch_down:
                if self.collide_point(*args[1].pos): root.toggle_week_mode()

        # Если week_mode — вывод всей недели (скрывает today/tomorrow, показывает week)
        ThemedLabel:
            id: week_label
            text: ""
            font_size: "18sp"
            halign: "left"
            valign: "top"
            color: 1, 1, 1, 1
            opacity: 0  # Скрыто по умолчанию
<PigsScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        Image:
            source: app.get_overlay_image("pigs")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"
        ThemedLabel:
            text: "Pig Farm"
            font_size: "32sp"
            halign: "center"
            color: 1, 1, 0.7, 1

        # Вода
        BoxLayout:
            spacing: "12dp"
            ThemedLabel:
                text: "Water"
                font_size: "20sp"
                size_hint_x: 0.2
            ProgressBar:
                id: water_bar
                max: 1
                value: 0.9
                size_hint_x: 0.6
            Button:
                text: "Give Water"
                font_name: app.theme_config["font_name"]
                on_release: root.reset_bar("water")

        # Еда
        BoxLayout:
            spacing: "12dp"
            ThemedLabel:
                text: "Food"
                font_size: "20sp"
                size_hint_x: 0.2
            ProgressBar:
                id: food_bar
                max: 1
                value: 0.8
                size_hint_x: 0.6
            Button:
                text: "Feed"
                font_name: app.theme_config["font_name"]
                on_release: root.reset_bar("food")

        # Очистка
        BoxLayout:
            spacing: "12dp"
            ThemedLabel:
                text: "Cleaning"
                font_size: "20sp"
                size_hint_x: 0.2
            ProgressBar:
                id: clean_bar
                max: 1
                value: 0.7
                size_hint_x: 0.6
            Button:
                text: "Clean"
                font_name: app.theme_config["font_name"]
                on_release: root.reset_bar("clean")

        ThemedLabel:
            id: pigs_status_label
            text: "Status: ???"
            font_size: "24sp"
            halign: "center"
            color: 1, 1, 1, 1