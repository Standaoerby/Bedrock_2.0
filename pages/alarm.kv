<AlarmScreen>:
    FloatLayout:
        size_hint: 1, 1

        # Screen overlay
        Image:
            source: app.get_overlay_image("alarm")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: app.theme_config.get("overlay_opacity", 0.5)

        # Main content container
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.9, 0.8
            pos_hint: {"center_x": 0.5, "center_y": 0.45}
            spacing: app.theme_config.get("grid_unit_half", "16dp")
            padding: [0, 0, 0, 0]
            
            # Section 1: Time and Active toggle
            ThemedPanel:
                orientation: "vertical"
                size_hint: 1, None
                height: app.theme_config.get("grid_unit_3x", "96dp")
                padding: app.theme_config.get("grid_unit_half", "16dp")
                
                GridLayout:
                    cols: 3
                    spacing: [app.theme_config.get("grid_unit", "32dp"), 0]
                    size_hint: 1, 1
                    
                    ThemedLabel:
                        text: "Time"
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                        size_hint_x: 0.1
                        halign: "left"
                        valign: "center"
        
                    # Time selection with +/- buttons
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.65
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        
                        # Hours (with buttons +/-)
                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_x: 0.47
                            
                            # Buttons column
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.3
                                
                                ThemedButton:
                                    text: "+"
                                    size_hint_y: 0.5
                                    on_release: root.increment_hour()
                                
                                ThemedButton:
                                    text: "-"
                                    size_hint_y: 0.5
                                    on_release: root.decrement_hour()
                            
                            # Hour display
                            ThemedLabel:
                                id: hour_label
                                text: root.alarm_time.split(':')[0]
                                font_size: "60sp"
                                halign: "center"
                                valign: "center"
                                size_hint_x: 0.7
                        
                        # Separator
                        ThemedLabel:
                            text: ":"
                            font_size: "60sp"
                            halign: "center"
                            valign: "center"
                            size_hint_x: 0.06
                        
                        # Minutes (with buttons +/-)
                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_x: 0.47
                            
                            # Minute display
                            ThemedLabel:
                                id: minute_label
                                text: root.alarm_time.split(':')[1]
                                font_size: "60sp"
                                halign: "center"
                                valign: "center"
                                size_hint_x: 0.7
                            
                            # Buttons column
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.3
                                
                                ThemedButton:
                                    text: "+"
                                    size_hint_y: 0.5
                                    on_release: root.increment_minute()
                                
                                ThemedButton:
                                    text: "-"
                                    size_hint_y: 0.5
                                    on_release: root.decrement_minute()
        
                    # Active toggle
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.25
                        
                        ThemedLabel:
                            text: "Active"
                            font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                            size_hint_x: 0.65
                            halign: "right"
                            valign: "center"
                            
                        CheckBox:
                            id: active_checkbox
                            active: root.alarm_active
                            size_hint_x: 0.35
                            on_active: root.on_active_toggled(self.active)
            
            # Section 2: Days of week
            BoxLayout:
                orientation: "vertical"
                size_hint: 1, None
                height: app.theme_config.get("grid_unit_1.5x", "48dp")
                
                GridLayout:
                    cols: 7
                    spacing: app.theme_config.get("grid_unit_quarter", "8dp")
                    size_hint: 1, 1
                    
                    ToggleButton:
                        id: repeat_mon
                        text: "Mon"
                        state: "down" if "Mon" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Mon", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_tue
                        text: "Tue"
                        state: "down" if "Tue" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Tue", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_wed
                        text: "Wed"
                        state: "down" if "Wed" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Wed", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_thu
                        text: "Thu"
                        state: "down" if "Thu" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Thu", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_fri
                        text: "Fri"
                        state: "down" if "Fri" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Fri", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_sat
                        text: "Sat"
                        state: "down" if "Sat" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Sat", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_sun
                        text: "Sun"
                        state: "down" if "Sun" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Sun", self.state)
                        font_name: app.theme_config["font_name"]
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
    
            # Section 3: Ringtone selection
            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: app.theme_config.get("grid_unit_1.5x", "48dp")
                spacing: app.theme_config.get("grid_unit_half", "16dp")
                padding: [app.theme_config.get("grid_unit_half", "16dp"), 0, 0, 0]
                
                # Label
                ThemedLabel:
                    text: "Ringtone:"
                    font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                    halign: "left"
                    valign: "center"
                    size_hint_x: 0.2
                
                # Spinner
                Spinner:
                    id: ringtone_spinner
                    text: root.selected_ringtone
                    values: root.ringtone_list
                    font_name: app.theme_config["font_name"]
                    font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    size_hint_x: 0.6
                    on_text: root.select_ringtone(self.text)
                
                # Play button
                ToggleButton:
                    id: play_button
                    text: "Play"
                    size_hint_x: 0.2
                    font_name: app.theme_config["font_name"]
                    font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    on_state: root.toggle_play_ringtone(self.state)
    
            # Section 4: Fade-in option
            ThemedPanel:
                orientation: "vertical"
                size_hint: 1, None
                height: app.theme_config.get("grid_unit_1.5x", "48dp")
                
                # Centered content for fade-in
                BoxLayout:
                    orientation: "horizontal"
                    size_hint: 1, 1
                    padding: app.theme_config.get("padding", "15dp")
                    
                    # Spacing
                    Widget:
                        size_hint_x: 0.3
                    
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.4
                        spacing: app.theme_config.get("spacing", "10dp")
                        
                        CheckBox:
                            id: fadein_checkbox
                            active: root.alarm_fadein
                            size_hint_x: None
                            width: app.theme_config.get("grid_unit", "32dp")
                            on_active: root.on_fadein_toggled(self.active)
                        
                        ThemedLabel:
                            text: "Fade-in volume"
                            font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                            halign: "left"
                            valign: "center"
                    
                    # Spacing
                    Widget:
                        size_hint_x: 0.3
    
            # Section 5: Save button
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint: 1, None
                height: app.theme_config.get("grid_unit_1.5x", "48dp")
                
                ThemedButton:
                    text: "Save"
                    font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                    size_hint: 0.3, None
                    height: app.theme_config.get("widget_heights", {}).get("button", "48dp")
                    on_release: root.save_alarm()