<ThemedLabel@Label>:
    font_name: app.font_name

BoxLayout:
    orientation: "vertical"

    BoxLayout:
        orientation: "horizontal"
        size_hint_y: None
        height: "64dp"
        padding: "8dp"
        spacing: "32dp"
        canvas.before:
            Color:
                rgba: 0.8, 0.8, 0.8, 1
            Rectangle:
                size: self.size
                pos: self.pos

        ThemedLabel:
            text: "HOME"
            color: app.theme_config["menu_selected_color"] if app.current_screen == "home" else app.theme_config["menu_unselected_color"]
            font_size: "22sp"
            size_hint_x: None
            width: "120dp"
            halign: "center"
            valign: "middle"
            on_touch_down:
                if self.collide_point(*args[1].pos): app.root.ids.screen_manager.current = "home"

        ThemedLabel:
            text: "ALARM"
            color: app.theme_config["menu_selected_color"] if app.current_screen == "alarm" else app.theme_config["menu_unselected_color"]
            font_size: "22sp"
            size_hint_x: None
            width: "120dp"
            halign: "center"
            valign: "middle"
            on_touch_down:
                if self.collide_point(*args[1].pos): app.root.ids.screen_manager.current = "alarm"


    # Экраны — как всегда
    MDScreenManager:
        id: screen_manager

        HomeScreen:
            name: "home"
        AlarmScreen:
            name: "alarm"

<HomeScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            text: "Это Home (main.kv + home.py)"
            color: 0, 0, 1, 1
            font_size: "32sp"
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.6}

<AlarmScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("alarm")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: 0.5
        ThemedLabel:
            text: "Это Alarm (main.kv + alarm.py)"
            color: 1, 0, 0, 1
            font_size: "32sp"
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.6}
