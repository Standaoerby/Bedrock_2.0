<SettingsScreen>:
    FloatLayout:
        size_hint: 1, 1
        
        # Только оверлей для этого экрана (без фонового изображения)
        Image:
            source: app.get_overlay_image("settings")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: app.theme_config.get("overlay_opacity", 0.5)
            
        # Main content
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.95, 0.9  # Increased from 0.85, 0.8
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: "20dp"

            # Theme settings
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: "180dp"
                padding: ["16dp", "12dp", "16dp", "12dp"]
                
                
                # Theme selection
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "50dp"
                    spacing: "10dp"
                    
                    ThemedLabel:
                        text: "Theme:"
                        font_size: "20sp"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3
                    
                    Spinner:
                        id: theme_spinner
                        text: root.current_theme
                        values: root.available_themes
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        size_hint_x: 0.7
                        on_text: root.change_theme(self.text)
                
                # Dark mode toggle (FIXED)
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "50dp"
                    spacing: "10dp"
                    
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.7
                        
                        ThemedLabel:
                            text: "Dark Mode" if root.dark_mode_available else "Dark Mode not available"
                            font_size: "20sp"
                            halign: "right"
                            valign: "middle"
                            color: [1, 1, 1, 1] if root.dark_mode_available else [0.6, 0.6, 0.6, 1]
                    
                    # Added toggle button for dark mode
                    Button:
                        id: dark_mode_button
                        text: "ON" if root.dark_mode_enabled else "OFF"
                        disabled: not root.dark_mode_available
                        size_hint_x: 0.3
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        opacity: 1.0 if root.dark_mode_available else 0.5
                        color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.dark_mode_enabled else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
                        on_press: app.play_sound("click")
                        on_release: root.toggle_dark_mode(not root.dark_mode_enabled)
            
            # User settings
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: None
                height: "120dp"
                padding: ["16dp", "12dp", "16dp", "12dp"]             

                
                # Username
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "40dp"
                    spacing: "10dp"
                    
                    ThemedLabel:
                        text: "Username:"
                        font_size: "20sp"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3
                    
                    TextInput:
                        id: username_input
                        text: root.username
                        font_name: app.theme_config["font_name"]
                        font_size: "20sp"
                        size_hint_x: 0.7
                        multiline: False
                        on_text_validate: root.save_username(self.text)
                
                # Birth date
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: "40dp"
                    spacing: "10dp"
                    
                    ThemedLabel:
                        text: "Birth Date:"
                        font_size: "20sp"
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.3
                    
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.7
                        spacing: "5dp"
                        
                        # Day input
                        TextInput:
                            id: birth_day
                            text: root.birth_day
                            font_name: app.theme_config["font_name"]
                            font_size: "20sp"
                            size_hint_x: 0.2
                            multiline: False
                            input_filter: "int"
                            on_text_validate: root.update_birthdate()
                        
                        ThemedLabel:
                            text: "/"
                            font_size: "20sp"
                            size_hint_x: 0.05
                            halign: "center"
                        
                        # Month input
                        TextInput:
                            id: birth_month
                            text: root.birth_month
                            font_name: app.theme_config["font_name"]
                            font_size: "20sp"
                            size_hint_x: 0.2
                            multiline: False
                            input_filter: "int"
                            on_text_validate: root.update_birthdate()
                        
                        ThemedLabel:
                            text: "/"
                            font_size: "20sp"
                            size_hint_x: 0.05
                            halign: "center"
                        
                        # Year input
                        TextInput:
                            id: birth_year
                            text: root.birth_year
                            font_name: app.theme_config["font_name"]
                            font_size: "20sp"
                            size_hint_x: 0.3
                            multiline: False
                            input_filter: "int"
                            on_text_validate: root.update_birthdate()
            
            # Save button
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: "70dp"
                
                ThemedButton:
                    text: "Save Settings"
                    font_size: "24sp"
                    size_hint: 0.5, None
                    height: "50dp"
                    on_release: root.save_all_settings()