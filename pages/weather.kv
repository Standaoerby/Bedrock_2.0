<WeatherScreen>:
    page_key: "weather"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            page_key: "weather"

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.96, 0.94
            pos_hint: {"center_x": 0.5, "top": 0.98}
            padding: app.ui_metrics["padding_xs"]
            spacing: app.ui_metrics["spacing_sm"]

            # Top row: Forecast | Sensors — same layout model on both
            # panels (heading + fixed-height rows + bottom spacer) so
            # row heights and panel padding line up across the seam.
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: 0.45
                spacing: app.ui_metrics["spacing_md"]

                ThemedPanel:
                    orientation: "vertical"
                    size_hint_x: 0.5
                    padding: app.ui_metrics["padding_md"]
                    spacing: app.ui_metrics["spacing_xs"]

                    ThemedLabel:
                        text: "Weather Forecast"
                        size_role: "section_title"
                        color_role: "font_highlight"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_lg"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: current_temp
                        text: "0°C"
                        size_role: "large"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_lg"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: current_condition
                        text: "Weather condition"
                        size_role: "metric_value"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size
                        shorten: True
                        shorten_from: "right"

                    ThemedLabel:
                        id: current_precipitation
                        text: "Precipitation: 0%"
                        size_role: "metric_value"
                        color_role: "font_secondary"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Widget:
                        # Bottom spacer — eats the remaining vertical
                        # space so heading/values stick to the top.

                ThemedPanel:
                    orientation: "vertical"
                    size_hint_x: 0.5
                    padding: app.ui_metrics["padding_md"]
                    spacing: app.ui_metrics["spacing_xs"]

                    ThemedLabel:
                        text: "Room Sensors"
                        size_role: "section_title"
                        color_role: "font_highlight"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_lg"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_temp
                        text: "Temperature: 0°C"
                        size_role: "metric_value"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_humidity
                        text: "Humidity: 0%"
                        size_role: "metric_value"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_co2
                        text: "CO2: 0 ppm"
                        size_role: "metric_value"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: sensor_tvoc
                        text: "TVOC: 0 ppb"
                        size_role: "metric_value"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    ThemedLabel:
                        id: air_quality
                        text: "Air Quality: Unknown"
                        size_role: "metric_value"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    Widget:

            # Bottom: Weekly forecast
            ThemedPanel:
                orientation: "vertical"
                size_hint_y: 0.55
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_sm"]

                ThemedLabel:
                    text: "Weekly Forecast"
                    size_role: "section_title"
                    color_role: "font_highlight"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_lg"]
                    halign: "center"
                    valign: "middle"
                    text_size: self.size

                OverflowColumn:
                    id: weekly_forecast_container
                    spacing: app.ui_metrics["spacing_xs"]
