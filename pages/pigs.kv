<PigsScreen>:
    page_key: "pigs"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            page_key: "pigs"

        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.96, 0.94
            pos_hint: {"center_x": 0.5, "top": 0.98}
            padding: app.ui_metrics["padding_xs"]
            spacing: app.ui_metrics["spacing_md"]

            # Left panel — 3 sections (Water/Food/Cleaning)
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.5
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_lg"]

                # Water section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Water"
                        size_role: "section_title"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        text_size: self.size
                        valign: "middle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.ui_metrics["spacing_md"]

                        CustomProgressBar:
                            id: water_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: app.ui_metrics["widget_height_sm"]
                            bar_color: app.theme_config.get("colors", {}).get("bar_water", [0, 0.6, 0.8, 0.8])

                        ThemedButton:
                            text: "Done"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.35
                            size_hint_y: None
                            height: app.ui_metrics["widget_height_md"]
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("water")

                # Food section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Food"
                        size_role: "section_title"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        text_size: self.size
                        valign: "middle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.ui_metrics["spacing_md"]

                        CustomProgressBar:
                            id: food_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: app.ui_metrics["widget_height_sm"]
                            bar_color: app.theme_config.get("colors", {}).get("bar_food", [0.8, 0.4, 0, 0.8])

                        ThemedButton:
                            text: "Done"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.35
                            size_hint_y: None
                            height: app.ui_metrics["widget_height_md"]
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("food")

                # Cleaning section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.ui_metrics["spacing_sm"]

                    ThemedLabel:
                        text: "Cleaning"
                        size_role: "section_title"
                        color_role: "font_default"
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                        halign: "left"
                        text_size: self.size
                        valign: "middle"

                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.ui_metrics["spacing_md"]

                        CustomProgressBar:
                            id: clean_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: app.ui_metrics["widget_height_sm"]
                            bar_color: app.theme_config.get("colors", {}).get("bar_clean", [0, 0.8, 0.2, 0.8])

                        ThemedButton:
                            text: "Done"
                            size_role: "field_label"
                            color_role: "font_default"
                            size_hint_x: 0.35
                            size_hint_y: None
                            height: app.ui_metrics["widget_height_md"]
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("clean")

            # Right panel — pig portrait
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.5
                padding: app.ui_metrics["padding_md"]

                Image:
                    id: pigs_image
                    source: "assets/images/pigs_1.png"
                    size_hint: 1, 1
                    fit_mode: 'contain'
