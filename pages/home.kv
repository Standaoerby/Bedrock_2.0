#:import MarqueeLabel classes.marquee.MarqueeLabel

<HomeScreen>:
    page_key: "home"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            source: app.theme_config.get("overlay_images", {}).get("home", "")

        # Date panel — top-left
        ThemedPanel:
            orientation: "vertical"
            size_hint: 0.35, None
            height: "48dp"
            pos_hint: {"x": 0.05, "top": 0.88}
            padding: ["20dp", "8dp", "12dp", "6dp"]

            ThemedLabel:
                id: date_label
                text: root.current_date
                size_role: "medium"
                color_role: "font_default"
                halign: "center"
                valign: "middle"
                shorten: False

        # Alarm panel — top-right
        ThemedPanel:
            orientation: "horizontal"
            size_hint: 0.35, None
            height: "48dp"
            pos_hint: {"right": 0.95, "top": 0.88}
            padding: ["10dp", "6dp", "10dp", "6dp"]
            spacing: "4dp"

            ThemedLabel:
                text: "Alarm:"
                size_role: "medium"
                color_role: "font_default"
                size_hint_x: 0.35
                halign: "right"
                valign: "middle"
                shorten: False

            ThemedLabel:
                id: alarm_time_label
                text: root.current_alarm_time
                size_role: "large"
                size_hint_x: 0.4
                halign: "center"
                valign: "middle"
                shorten: False
                color: app.theme_config.get("colors", {}).get("semi_active", [0.7, 1, 0.7, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("font_disabled", [0.4, 0.4, 0.4, 1])

            ThemedButton:
                id: alarm_status_button
                text: "ON" if root.alarm_active else "OFF"
                size_role: "medium"
                size_hint_x: 0.25
                size_hint_y: 0.85
                pos_hint: {"center_y": 0.5}
                color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
                on_press: app.play_sound("click")
                on_release: root.toggle_alarm()

        # Clock shadow — plain Label, not ThemedLabel, so the per-instance
        # color isn't fought by anything. Shadow color flips with theme.
        Label:
            id: clock_shadow_label
            text: clock_label.text
            font_name: app.theme_config.get("font_name", "Minecraftia")
            font_size: app.theme_config.get("font_sizes", {}).get("huge", "160sp")
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.51, "center_y": 0.49}
            color: app.theme_config.get("colors", {}).get("shadow_dark", [1, 1, 1, 0.35]) if app.theme_mode == "dark" else app.theme_config.get("colors", {}).get("shadow_light", [0, 0, 0, 0.5])

        ThemedLabel:
            id: clock_label
            text: "00:00"
            color_role: "font_default"
            font_size: app.theme_config.get("font_sizes", {}).get("huge", "160sp")
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}

        # Weather panel — bottom-center above the marquee
        ThemedPanel:
            orientation: "vertical"
            size_hint: 0.6, None
            height: "48dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.22}
            padding: ["10dp", "8dp", "10dp", "6dp"]

            BoxLayout:
                orientation: "horizontal"
                spacing: "16dp"

                ThemedLabel:
                    id: weather_now_label
                    text: root.weather_now_str
                    size_role: "large"
                    color_role: "font_default"
                    size_hint_x: 0.6
                    halign: "center"
                    valign: "middle"

                BoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 0.4
                    spacing: "6dp"

                    ThemedLabel:
                        id: weather_trend_label
                        text: root.weather_trend_arrow
                        size_role: "large"
                        size_hint_x: 0.25
                        halign: "right"
                        valign: "middle"
                        color: app.theme_config.get("colors", {}).get("trend_down", [0, 0.6, 1, 1]) if root.weather_trend_arrow == "↓" else (app.theme_config.get("colors", {}).get("trend_up", [1, 0.3, 0.3, 1]) if root.weather_trend_arrow == "↑" else app.theme_config.get("colors", {}).get("font_default", [1, 1, 1, 1]))

                    ThemedLabel:
                        id: weather_forecast_label
                        text: root.weather_5h_str
                        size_role: "medium"
                        color_role: "font_default"
                        size_hint_x: 0.75
                        halign: "left"
                        valign: "middle"

        # Notification marquee — bottom strip
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.85, None
            height: "56dp"
            pos_hint: {"center_x": 0.5, "y": 0.03}

            MarqueeLabel:
                id: notification_label
                full_text: root.notification_text
                text: root.notification_text
                font_name: app.theme_config.get("font_name", "Minecraftia")
                color: app.theme_config.get("colors", {}).get("font_default", [1, 1, 1, 1])
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
