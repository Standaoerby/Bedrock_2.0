<HomeScreen>:
    FloatLayout:
        size_hint: 1, 1
        # ИСПРАВЛЕНО: Overlay изображение с правильным id
        Image:
            id: home_overlay
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: True
            size_hint: None, None
            width: self.parent.width
            height: self.parent.height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            
        # Date panel
        ThemedPanel:
            id: date_panel
            orientation: "vertical"
            size_hint: 0.38, None
            height: "60dp"
            pos_hint: {"x": 0.05, "top": 0.95}
            padding: ["25dp", "10dp", "15dp", "6dp"]
            
            ThemedLabel:
                id: date_label
                text: root.current_date
                font_size: "24sp"
                halign: "center"
                valign: "middle"
                shorten: False

        # Alarm panel
        ThemedPanel:
            id: alarm_panel
            orientation: "horizontal"
            size_hint: 0.38, None
            height: "60dp"
            pos_hint: {"right": 0.95, "top": 0.95}
            padding: ["10dp", "6dp", "10dp", "6dp"]
            spacing: "4dp"
            
            ThemedLabel:
                text: "Alarm:"
                font_size: "22sp"
                size_hint_x: 0.35
                halign: "right"
                valign: "middle"
                shorten: False
                
            ThemedLabel:
                id: alarm_time_label
                text: root.current_alarm_time
                font_size: "28sp"
                size_hint_x: 0.4
                halign: "center"
                valign: "middle"
                shorten: False
                color: app.theme_config.get("colors", {}).get("semi_active", [0.7, 1, 0.7, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.4, 0.4, 0.4, 1])
                
            Button:
                id: alarm_status_button
                text: "ON" if root.alarm_active else "OFF"
                size_hint_x: 0.25
                size_hint_y: 0.9
                pos_hint: {"center_y": 0.55}
                font_name: app.theme_config.get("font_name", "Minecraftia")
                font_size: "20sp"
                color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
                background_normal: app.theme_config.get("button_normal", "atlas://data/images/defaulttheme/button")
                background_down: app.theme_config.get("button_active", "atlas://data/images/defaulttheme/button_pressed")
                on_press: app.play_sound("click")
                on_release: root.toggle_alarm()

        # ИСПРАВЛЕНО: Главные часы без принудительных обновлений
        ThemedLabel:
            id: clock_shadow_label
            text: clock_label.text if clock_label else "00:00"
            font_size: str(min(float(app.theme_config.get("font_sizes", {}).get("huge", "240").replace("sp", "")) * 1.5, Window.height * 0.375)) + "sp"
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.51, "center_y": 0.56}
            color: app.theme_config.get("colors", {}).get("shadow", [0.2, 0.2, 0.2, 0.4])
            
        ThemedLabel:
            id: clock_label
            text: "00:00"
            font_size: str(min(float(app.theme_config.get("font_sizes", {}).get("huge", "240").replace("sp", "")) * 1.5, Window.height * 0.375)) + "sp"
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.57}
            color: app.theme_config.get("font_color", [1, 1, 1, 1])

        # Weather panel
        ThemedPanel:
            id: weather_panel
            orientation: "vertical"
            size_hint: 0.65, None
            height: app.theme_config.get("grid_unit_1.5x", "48dp")
            pos_hint: {"center_x": 0.5, "center_y": 0.24}
            padding: ["10dp", "12dp", "10dp", "6dp"]
            
            BoxLayout:
                orientation: "horizontal"
                spacing: app.theme_config.get("grid_unit_half", "16dp")
                
                # Current temperature & condition
                ThemedLabel:
                    id: weather_now_label
                    text: root.weather_now_str
                    font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")
                    size_hint_x: 0.6
                    halign: "center"
                    valign: "middle"
                
                # ИСПРАВЛЕНО: Forecast temperature без принудительных обновлений
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 0.5
                    spacing: app.theme_config.get("grid_unit_quarter", "8dp")
                    
                    ThemedLabel:
                        id: weather_trend_label
                        text: root.weather_trend_arrow
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
                        size_hint_x: 0.2
                        halign: "left"
                        valign: "middle"
                        color: app.theme_config.get("colors", {}).get("trend_down", [0.2, 0.6, 1, 1]) if root.weather_trend_arrow == "↓" else (app.theme_config.get("colors", {}).get("trend_up", [1, 0.4, 0.4, 1]) if root.weather_trend_arrow == "↑" else app.theme_config.get("font_color", [1, 1, 1, 1]))
                        
                    ThemedLabel:
                        id: weather_forecast_label
                        text: root.weather_5h_str
                        font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
                        size_hint_x: 0.8
                        halign: "left"
                        valign: "middle"

        # Notification widget (bottom)
        BoxLayout:
            id: notification_container
            orientation: "horizontal"
            size_hint: 0.85, None
            height: app.theme_config.get("grid_unit_2x", "64dp")
            pos_hint: {"center_x": 0.5, "y": 0.03}
            
            MarqueeLabel:
                id: notification_label
                full_text: root.notification_text
                font_name: app.theme_config.get("font_name", "Minecraftia")
                color: app.theme_config.get("font_color", [1, 1, 1, 1])
                font_size: app.theme_config.get("widget_font_size", "20sp")