#:import MarqueeLabel classes.marquee.MarqueeLabel

<HomeScreen>:
    FloatLayout:
        size_hint_y: 1
        Image:
            source: app.theme_config["background_image"]
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        Image:
            source: app.get_overlay_image("home")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: app.theme_config.get("overlay_opacity", 0.5)
        ThemedLabel:
            id: debug_marker
            text: "debug_marker"
            font_size: app.theme_config.get("font_sizes", {}).get("tiny", "1sp")

        ThemedLabel:
            id: clock_label
            text: "00:00"
            font_size: app.theme_config.get("font_sizes", {}).get("huge", "200sp")
            halign: "center"
            valign: "middle"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            
        # Alarm widget (слева вверху)
        ThemedPanel:
            orientation: "horizontal"
            size_hint: 0.38, None
            height: app.theme_config.get("widget_heights", {}).get("large", "64dp")
            pos_hint: {"x": 0.05, "top": 0.94}
            spacing: app.theme_config.get("spacing_small", "8dp")
            ThemedLabel:
                text: "Alarm:"
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
            ThemedLabel:
                id: alarm_time_label
                text: root.current_alarm_time
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
                color: app.theme_config.get("colors", {}).get("semi_active", [0.7, 1, 0.7, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
            ThemedLabel:
                id: alarm_status_label
                text: "ON" if root.alarm_active else "OFF"
                color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])

        # Weather widget (справа вверху)
        ThemedPanel:
            orientation: "horizontal"
            size_hint: 0.52, None
            height: app.theme_config.get("widget_heights", {}).get("large", "64dp")
            pos_hint: {"right": 0.95, "top": 0.94}
            spacing: app.theme_config.get("spacing_small", "8dp")
            ThemedLabel:
                text: "Weather:"
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
            ThemedLabel:
                id: weather_now_label
                text: root.weather_now_str
                font_size: app.theme_config.get("font_sizes", {}).get("medium", "22sp")
            ThemedLabel:
                id: weather_forecast_label
                text: root.weather_5h_str
            ThemedLabel:
                id: weather_trend_label
                text: root.weather_trend_arrow
                font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")

        # Notification widget (бегущая строка — внизу)
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.8, None
            height: "48dp"
            pos_hint: {"center_x": 0.5, "y": 0.03}
            MarqueeLabel:
                id: notification_label
                full_text: root.notification_text
                text: root.notification_text
                font_name: app.theme_config["font_name"]
                color: app.theme_config["font_color"]
                font_size: app.theme_config.get("widget_font_size", "20sp")