[Unit]
Description=Bedrock 2.0 — touchscreen panel for Pi 5
After=graphical-session.target network-online.target
PartOf=graphical-session.target
Wants=network-online.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=@REPO_PATH@
# X11 env: when bedrock starts before lightdm finishes autologin, the user
# systemd manager has no DISPLAY/XAUTHORITY in its env, so we set them
# explicitly. /home/pi/.Xauthority is created by lightdm during autologin.
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# Without XDG_SESSION_TYPE, SDL2 on a headless-systemd-launched process
# silently falls back to a non-X video backend (no visible window).
Environment=XDG_SESSION_TYPE=x11
# Audio: KIVY_AUDIO=ffpyplayer + SDL_AUDIODRIVER=pulse.
#
# audio_sdl2 (SDL_mixer) hangs at startup on Trixie + Kivy 2.3 +
# pipewire-pulse — Audio Providers prints `audio_sdl2`, then the build
# process never reaches `Start application main loop`. We don't get to
# diagnose further because no UI ever appears.
#
# audio_ffpyplayer used to log a "Channel layout change is not
# supported" abuffersink error on every play, but with mono/16-bit/
# 48kHz WAVs that warning is non-fatal and playback now actually
# reaches the device (verified with `pw-play` that the WAVs are
# routable). Keep ffpyplayer + suppress the cosmetic log noise.
Environment=KIVY_AUDIO=ffpyplayer
Environment=SDL_AUDIODRIVER=pulse
# Wait briefly for X to come up — without this, on a cold boot the unit can
# race lightdm and the SDL2 backend silently never opens a window.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; exit 1'
# Kiosk panel — keep the screen on permanently. X11 default is to blank
# the display after ~10 minutes of no input and DPMS-suspend it shortly
# after; that produced "black screen but service still running" overnight
# even though bedrock was perfectly healthy. -dpms disables DPMS,
# `s off` disables the screensaver blank, `s noblank` keeps it from
# blanking on inactivity.
ExecStartPre=/bin/sh -c '/usr/bin/xset -dpms s off s noblank || true'
ExecStart=@REPO_PATH@/venv/bin/python @REPO_PATH@/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
# lightdm doesn't auto-activate graphical-session.target in user scope,
# so a unit Wanted by it would never start at boot. We rely on a desktop
# autostart entry (~/.config/autostart/bedrock.desktop) to invoke
# `systemctl --user start bedrock` after the X session comes up.
WantedBy=default.target
