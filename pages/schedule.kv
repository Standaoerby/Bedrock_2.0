<ScheduleScreen>:
    FloatLayout:
        size_hint: 1, 1
        
        # Screen overlay (matching other screens)
        Image:
            source: app.get_overlay_image("schedule")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: app.theme_config.get("overlay_opacity", 0.5)
        
        BoxLayout:
            orientation: 'vertical'
            padding: "10dp"  # Reduced from 15dp
            spacing: "5dp"   # Reduced from 10dp
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            size_hint: 0.95, 0.95  # Increased from 0.9, 0.9
            
            # Weekly schedule panel
            ThemedPanel:
                orientation: 'vertical'
                padding: "10dp"
                spacing: "5dp"
                
                # Day headers grid
                GridLayout:
                    id: header_grid
                    cols: 5
                    spacing: "5dp"  # Reduced from 10dp
                    size_hint_y: None
                    height: "40dp"
                
                # Main schedule content
                BoxLayout:
                    id: schedule_content
                    orientation: "horizontal"
                    spacing: "5dp"  # Reduced from 10dp