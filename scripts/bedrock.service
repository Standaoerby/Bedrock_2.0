[Unit]
Description=Bedrock 2.0 — touchscreen panel for Pi 5
After=graphical-session.target network-online.target
PartOf=graphical-session.target
Wants=network-online.target graphical-session.target

[Service]
Type=simple
WorkingDirectory=@REPO_PATH@
# X11 env: when bedrock starts before lightdm finishes autologin, the user
# systemd manager has no DISPLAY/XAUTHORITY in its env, so we set them
# explicitly. /home/pi/.Xauthority is created by lightdm during autologin.
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
# Audio: KIVY_AUDIO=ffpyplayer (FFmpeg) since the Kivy aarch64+py3.13 wheel
# has no _gstplayer extension, and audio_sdl2's SDL_mixer init hangs on
# Trixie+pipewire. ffpyplayer needs a real SDL audio device for output —
# `pulse` routes through pipewire-pulse, which is fine because it's
# SDL_OpenAudio (not SDL_mixer that caused the original hang).
Environment=KIVY_AUDIO=ffpyplayer
Environment=SDL_AUDIODRIVER=pulse
# Wait briefly for X to come up — without this, on a cold boot the unit can
# race lightdm and the SDL2 backend silently never opens a window.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -S /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done; exit 1'
ExecStart=@REPO_PATH@/venv/bin/python @REPO_PATH@/main.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
