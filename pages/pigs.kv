<PigsScreen>:
    FloatLayout:
        size_hint: 1, 1

        # Screen overlay
        Image:
            source: app.get_overlay_image("pigs")
            allow_stretch: True
            keep_ratio: True  # Changed to True to maintain aspect ratio
            size_hint: None, None  # Using explicit sizes instead of size_hint
            width: self.parent.width
            height: self.parent.height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            # opacity: app.theme_config.get("overlay_opacity", 0.5)

        # Main content container - split into left and right panels
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.95, 0.85  # Increased from 0.9, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.52}  # Aligned with schedule page
            spacing: app.theme_config.get("grid_unit", "32dp")
            
            # Left panel with controls
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.4
                padding: [app.theme_config.get("padding", "15dp"), "10dp", app.theme_config.get("padding", "15dp"), "20dp"]  # Added top padding to move bars up
                spacing: app.theme_config.get("grid_unit", "27dp")  # Reduced from 32dp to move everything up a bit
                
                # Water section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.theme_config.get("grid_unit_half", "16dp")
                    
                    # Water label
                    ThemedLabel:
                        text: "Water"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "24sp")
                        size_hint_y: None
                        height: app.theme_config.get("grid_unit", "32dp")
                        halign: "left"
                        text_size: self.size
                        valign: "middle"
                        padding_y: "-5dp"  # Negative padding to move up
                    
                    # Water bar and button in row - UNIFORM HEIGHT
                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        size_hint_y: None
                        height: "40dp"  # Unified height for container
                        
                        # Progress bar (no AnchorLayout wrapper)
                        CustomProgressBar:
                            id: water_bar
                            size_hint_x: 0.65
                            bar_color: [0, 0.6, 0.8, 0.8]  # Blue for water
                        
                        # Water button
                        ThemedButton:
                            text: "Done"
                            size_hint_x: 0.35
                            on_release: root.reset_bar("water")
                
                # Food section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.theme_config.get("grid_unit_half", "16dp")
                    
                    # Food label
                    ThemedLabel:
                        text: "Food"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "24sp")
                        size_hint_y: None
                        height: app.theme_config.get("grid_unit", "32dp")
                        halign: "left"
                        text_size: self.size
                        valign: "middle"
                        padding_y: "-5dp"  # Negative padding to move up
                    
                    # Food bar and button in row - UNIFORM HEIGHT
                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        size_hint_y: None
                        height: "40dp"  # Unified height for container
                        
                        # Progress bar (no AnchorLayout wrapper)
                        CustomProgressBar:
                            id: food_bar
                            size_hint_x: 0.65
                            bar_color: [0.8, 0.4, 0, 0.8]  # Orange/brown for food
                        
                        # Food button
                        ThemedButton:
                            text: "Done"
                            size_hint_x: 0.35
                            on_release: root.reset_bar("food")
                
                # Cleaning section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.theme_config.get("grid_unit_half", "16dp")
                    
                    # Cleaning label
                    ThemedLabel:
                        text: "Cleaning"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "24sp")
                        size_hint_y: None
                        height: app.theme_config.get("grid_unit", "32dp")
                        halign: "left"
                        text_size: self.size
                        valign: "middle"
                        padding_y: "-5dp"  # Negative padding to move up
                    
                    # Cleaning bar and button in row - UNIFORM HEIGHT
                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        size_hint_y: None
                        height: "40dp"  # Unified height for container
                        
                        # Progress bar (no AnchorLayout wrapper)
                        CustomProgressBar:
                            id: clean_bar
                            size_hint_x: 0.65
                            bar_color: [0, 0.8, 0.2, 0.8]  # Green for cleaning
                        
                        # Cleaning button
                        ThemedButton:
                            text: "Done"
                            size_hint_x: 0.35
                            on_release: root.reset_bar("clean")
            
            # Right panel with pig image
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.6
                padding: app.theme_config.get("padding", "15dp")
                
                # Pig image
                Image:
                    id: pigs_image
                    source: "assets/images/pigs_1.png"
                    size_hint: 1, 1
                    allow_stretch: True
                    keep_ratio: True
                
                # Hidden status elements (for compatibility)
                ThemedLabel:
                    id: pigs_status_label
                    text: "Happiness: 64%"
                    opacity: 0
                    size_hint_y: None
                    height: 0
                
                ThemedLabel:
                    id: status_emoji
                    text: "🐷"
                    opacity: 0
                    size_hint_y: None
                    height: 0