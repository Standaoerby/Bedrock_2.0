<PigsScreen>:
    FloatLayout:
        size_hint: 1, 1

        # Только оверлей для этого экрана (без фонового изображения)
        Image:
            source: app.get_overlay_image("pigs")
            allow_stretch: True
            keep_ratio: False
            size_hint: 1, 1
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            opacity: app.theme_config.get("overlay_opacity", 0.5)

        # Main content container - split into left and right panels
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.9, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            spacing: app.theme_config.get("grid_unit", "32dp")
            
            # Left panel with controls
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.4
                padding: app.theme_config.get("grid_unit_half", "16dp")
                spacing: app.theme_config.get("grid_unit", "32dp")  # Space between sections
                
                # Water section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.theme_config.get("grid_unit_half", "16dp")  # Space between elements
                    
                    # Water label
                    ThemedLabel:
                        text: "Water"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")
                        size_hint_y: None
                        height: app.theme_config.get("grid_unit", "32dp")
                        halign: "left"
                        text_size: self.size
                        valign: "middle"
                    
                    # Water bar and button in row
                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        
                        # Custom water progress bar - MUCH TALLER
                        CustomProgressBar:
                            id: water_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: "30dp"  # MUCH TALLER
                            bar_color: [0, 0.6, 0.8, 0.8]  # Blue for water
                            canvas.before:
                                Color:
                                    rgba: 0.15, 0.15, 0.15, 0.5  # Dark background
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [4]
                        
                        # Water button
                        ThemedButton:
                            text: "Done"
                            size_hint_x: 0.35
                            height: "40dp"
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("water")
                
                # Food section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.theme_config.get("grid_unit_half", "16dp")
                    
                    # Food label
                    ThemedLabel:
                        text: "Food"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")
                        size_hint_y: None
                        height: app.theme_config.get("grid_unit", "32dp")
                        halign: "left"
                        text_size: self.size
                        valign: "middle"
                    
                    # Food bar and button in row
                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        
                        # Custom food progress bar - MUCH TALLER
                        CustomProgressBar:
                            id: food_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: "30dp"  # MUCH TALLER
                            bar_color: [0.8, 0.4, 0, 0.8]  # Orange/brown for food
                            canvas.before:
                                Color:
                                    rgba: 0.15, 0.15, 0.15, 0.5
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [4]
                        
                        # Food button
                        ThemedButton:
                            text: "Done"
                            size_hint_x: 0.35
                            height: "40dp"
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("food")
                
                # Cleaning section
                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: 0.33
                    spacing: app.theme_config.get("grid_unit_half", "16dp")
                    
                    # Cleaning label
                    ThemedLabel:
                        text: "Cleaning"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "26sp")
                        size_hint_y: None
                        height: app.theme_config.get("grid_unit", "32dp")
                        halign: "left"
                        text_size: self.size
                        valign: "middle"
                    
                    # Cleaning bar and button in row
                    BoxLayout:
                        orientation: "horizontal"
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        
                        # Custom cleaning progress bar - MUCH TALLER
                        CustomProgressBar:
                            id: clean_bar
                            size_hint_x: 0.65
                            size_hint_y: None
                            height: "30dp"  # MUCH TALLER
                            bar_color: [0, 0.8, 0.2, 0.8]  # Green for cleaning
                            canvas.before:
                                Color:
                                    rgba: 0.15, 0.15, 0.15, 0.5
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [4]
                        
                        # Cleaning button
                        ThemedButton:
                            text: "Done"
                            size_hint_x: 0.35
                            height: "40dp"
                            on_press: app.play_sound("click")
                            on_release: root.reset_bar("clean")
            
            # Right panel with pig image
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.6
                padding: app.theme_config.get("grid_unit_half", "16dp")
                
                # Pig image (fills the panel)
                Image:
                    id: pigs_image
                    source: "assets/images/pigs_1.png"
                    size_hint: 1, 1
                    allow_stretch: True
                    keep_ratio: True
                
                # Hidden status elements (for compatibility)
                ThemedLabel:
                    id: pigs_status_label
                    text: "Happiness: 64%"
                    opacity: 0
                    size_hint_y: None
                    height: 0
                
                ThemedLabel:
                    id: status_emoji
                    text: "🐷"
                    opacity: 0
                    size_hint_y: None
                    height: 0