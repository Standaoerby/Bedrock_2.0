<ScheduleScreen>:
    page_key: "schedule"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            source: app.theme_config.get("overlay_images", {}).get("schedule", "")

        # Today + Tomorrow (visible when not in week mode)
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.9, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.48}
            spacing: "16dp"
            opacity: 1 if not root.week_mode else 0

            # Today (left, larger)
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.6
                padding: "12dp"

                ThemedLabel:
                    text: "Today: %s, %s" % (root.today_date, root.today_day)
                    size_role: "medium"
                    color_role: "font_highlight"
                    bold: True
                    size_hint_y: None
                    height: "32dp"

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True

                    ThemedLabel:
                        id: today_label
                        text: "..."
                        size_role: "small"
                        color_role: "font_default"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: "left"
                        valign: "top"
                        padding: "8dp", 0

            # Tomorrow (right, smaller)
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.4
                padding: "12dp"

                ThemedLabel:
                    text: "Tomorrow: %s, %s" % (root.tomorrow_date, root.tomorrow_day)
                    size_role: "small"
                    color_role: "font_secondary"
                    bold: True
                    size_hint_y: None
                    height: "32dp"

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True

                    ThemedLabel:
                        id: tomorrow_label
                        text: "..."
                        size_role: "tiny"
                        color_role: "font_default"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: "left"
                        valign: "top"
                        padding: "8dp", 0

        # Weekly view (visible when week_mode)
        ThemedPanel:
            orientation: "vertical"
            size_hint: 0.9, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.45}
            opacity: 1 if root.week_mode else 0
            padding: "12dp"

            GridLayout:
                id: week_grid
                cols: 5
                spacing: "8dp"
                size_hint_y: 1

                # Five day columns. id's are referenced from Python.
                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Monday"
                        size_role: "small"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: "32dp"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: monday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Tuesday"
                        size_role: "small"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: "32dp"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: tuesday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Wednesday"
                        size_role: "small"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: "32dp"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: wednesday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Thursday"
                        size_role: "small"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: "32dp"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: thursday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Friday"
                        size_role: "small"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: "32dp"
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: friday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

        # Toggle button
        ThemedButton:
            id: week_button
            text: "View Weekly Schedule" if not root.week_mode else "Back to Today's Schedule"
            size_role: "small"
            size_hint: 0.5, None
            height: "40dp"
            pos_hint: {"center_x": 0.5, "center_y": 0.08}
            on_press: app.play_sound("click")
            on_release: root.toggle_week_mode()
