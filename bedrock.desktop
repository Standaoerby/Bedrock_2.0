[Desktop Entry]
Type=Application
Name=Bedrock 2.0 - Pi 5 Kiosk (Fixed)
Comment=Bedrock 2.0 fullscreen application for Raspberry Pi 5 (1024x600 touchscreen) - Fixed version
# ИСПРАВЛЕНО: Упрощенная команда запуска с меньшей задержкой
Exec=bash -c "sleep 10 && cd /home/standa/bedrock-app && source venv/bin/activate && export DISPLAY=:0 && python bedrock_launcher.py >> logs/autostart.log 2>&1"
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
StartupNotify=false
Terminal=false
Categories=Kiosk;System;Utility;
Icon=/home/standa/bedrock-app/assets/images/bedrock_icon.png
# ДОБАВЛЕНО: Настройки для надёжного запуска
X-GNOME-Autostart-Delay=10
X-KDE-autostart-after=panel