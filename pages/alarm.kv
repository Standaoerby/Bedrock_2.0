<AlarmScreen>:
    page_key: "alarm"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            page_key: "alarm"

        BoxLayout:
            orientation: "vertical"
            size_hint: 0.96, None
            height: self.minimum_height
            pos_hint: {"center_x": 0.5, "top": 0.98}
            padding: app.ui_metrics["padding_xs"]
            spacing: app.ui_metrics["spacing_sm"]

            # Section 1: Time + Active toggle
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "120dp"
                spacing: app.ui_metrics["spacing_md"]

                ThemedLabel:
                    text: "Time"
                    size_role: "field_label"
                    color_role: "font_default"
                    size_hint_x: 0.12
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                # Hours +/- digit
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.12

                    ThemedButton:
                        text: "+"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.increment_hour()

                    ThemedButton:
                        text: "-"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.decrement_hour()

                ThemedLabel:
                    id: hour_label
                    text: root.alarm_time.split(':')[0]
                    size_role: "huge"
                    color_role: "font_default"
                    size_hint_x: 0.18
                    halign: "center"
                    valign: "middle"
                    # Picker digit — big but not full-screen-clock big.
                    font_size: "72sp"

                ThemedLabel:
                    text: ":"
                    size_role: "huge"
                    color_role: "font_default"
                    size_hint_x: 0.04
                    halign: "center"
                    valign: "middle"
                    font_size: "72sp"

                ThemedLabel:
                    id: minute_label
                    text: root.alarm_time.split(':')[1]
                    size_role: "huge"
                    color_role: "font_default"
                    size_hint_x: 0.18
                    halign: "center"
                    valign: "middle"
                    font_size: "72sp"

                # Minutes +/-
                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.12

                    ThemedButton:
                        text: "+"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.increment_minute()

                    ThemedButton:
                        text: "-"
                        size_role: "large"
                        color_role: "font_default"
                        on_press: app.play_sound("click")
                        on_release: root.decrement_minute()

                # Active toggle
                BoxLayout:
                    orientation: "horizontal"
                    size_hint_x: 0.24
                    spacing: app.ui_metrics["spacing_xs"]

                    ThemedLabel:
                        text: "Active"
                        size_role: "field_label"
                        color_role: "font_default"
                        size_hint_x: 0.6
                        halign: "right"
                        valign: "middle"
                        text_size: self.size

                    CheckBox:
                        id: active_checkbox
                        active: root.alarm_active
                        size_hint_x: 0.4
                        on_press: app.play_sound("click")
                        on_active: root.on_active_toggled(self.active)

            # Section 2: Repeat days
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"] + app.ui_metrics["widget_height_sm"] + app.ui_metrics["spacing_xs"]
                spacing: app.ui_metrics["spacing_xs"]

                ThemedLabel:
                    text: "Repeat on days:"
                    size_role: "field_label"
                    color_role: "font_default"
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_sm"]
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                GridLayout:
                    cols: 7
                    spacing: app.ui_metrics["spacing_sm"]
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]

                    ThemedToggleButton:
                        id: repeat_mon
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Mon"
                        state: "down" if "Mon" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Mon", self.state)
                    ThemedToggleButton:
                        id: repeat_tue
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Tue"
                        state: "down" if "Tue" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Tue", self.state)
                    ThemedToggleButton:
                        id: repeat_wed
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Wed"
                        state: "down" if "Wed" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Wed", self.state)
                    ThemedToggleButton:
                        id: repeat_thu
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Thu"
                        state: "down" if "Thu" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Thu", self.state)
                    ThemedToggleButton:
                        id: repeat_fri
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Fri"
                        state: "down" if "Fri" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Fri", self.state)
                    ThemedToggleButton:
                        id: repeat_sat
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Sat"
                        state: "down" if "Sat" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Sat", self.state)
                    ThemedToggleButton:
                        id: repeat_sun
                        color_role: "font_default"
                        size_role: "field_label"
                        text: "Sun"
                        state: "down" if "Sun" in root.alarm_repeat else "normal"
                        on_press: app.play_sound("click")
                        on_state: root.toggle_repeat("Sun", self.state)

            # Section 3: Ringtone + Play
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"]
                spacing: app.ui_metrics["spacing_sm"]

                ThemedLabel:
                    text: "Ringtone:"
                    size_role: "field_label"
                    color_role: "font_default"
                    size_hint_x: 0.18
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                ThemedSpinner:
                    id: ringtone_spinner
                    text: root.selected_ringtone
                    values: root.ringtone_list
                    size_role: "field_label"
                    color_role: "font_default"
                    size_hint_x: 0.6
                    on_text: root.select_ringtone(self.text)

                ThemedToggleButton:
                    id: play_button
                    color_role: "font_default"
                    size_role: "field_label"
                    text: "Play"
                    size_hint_x: 0.22
                    on_state: root.toggle_play_ringtone(self.state)

            # Section 4: Fade-in
            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"]
                spacing: app.ui_metrics["spacing_sm"]

                Widget:
                    size_hint_x: 0.3

                CheckBox:
                    id: fadein_checkbox
                    active: root.alarm_fadein
                    size_hint_x: None
                    width: app.ui_metrics["widget_height_sm"]
                    on_press: app.play_sound("click")
                    on_active: root.on_fadein_toggled(self.active)

                ThemedLabel:
                    text: "Fade-in volume"
                    size_role: "field_label"
                    color_role: "font_default"
                    size_hint_x: 0.4
                    halign: "left"
                    valign: "middle"
                    text_size: self.size

                Widget:
                    size_hint_x: 0.3

            # Section 5: Save
            AnchorLayout:
                anchor_x: "center"
                anchor_y: "center"
                size_hint_y: None
                height: app.ui_metrics["widget_height_md"]

                ThemedButton:
                    text: "Save"
                    size_role: "large"
                    color_role: "font_default"
                    size_hint: 0.3, None
                    height: app.ui_metrics["widget_height_md"]
                    on_press: app.play_sound("click")
                    on_release: root.save_alarm()
