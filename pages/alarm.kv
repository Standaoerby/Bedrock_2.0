<AlarmScreen>:
    FloatLayout:
        size_hint: 1, 1

        # Screen overlay
        Image:
            source: app.get_overlay_image("alarm")
            allow_stretch: True
            keep_ratio: True  # Changed to True to maintain aspect ratio
            size_hint: None, None  # Using explicit sizes instead of size_hint
            width: self.parent.width
            height: self.parent.height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            # opacity: app.theme_config.get("overlay_opacity", 0.5)

        # Main content container - EXPANDED VERTICALLY
        BoxLayout:
            orientation: "vertical"
            size_hint: 0.95, 0.95  # Increased from 0.9 to 0.95 height
            pos_hint: {"center_x": 0.5, "center_y": 0.48}  # Shifted down by moving center_y from 0.5 to 0.48
            spacing: app.theme_config.get("grid_unit_quarter", "8dp")  # Reduced spacing between sections
            padding: [0, 0, 0, 0]
            
            # Section 1: Time and Active toggle - EXPANDED SIGNIFICANTLY
            ThemedPanel:
                orientation: "vertical"
                size_hint: 1, 0.48  # Reduced by 20% (from 0.6 to 0.48)
                padding: app.theme_config.get("grid_unit_half", "16dp")
                
                # Use GridLayout with rows to better control alignment
                GridLayout:
                    cols: 3
                    # Center the entire time setup horizontally
                    size_hint_x: 0.9  # Add some margin on both sides
                    pos_hint: {"center_x": 0.5}  # Center it
                    spacing: [app.theme_config.get("grid_unit", "32dp"), 0]
                    size_hint_y: 1
                    
                    ThemedLabel:
                        text: "Time"
                        font_size: app.theme_config.get("font_sizes", {}).get("xlarge", "34sp")
                        size_hint_x: 0.15
                        halign: "left"
                        valign: "center"
        
                    # Time selection with +/- buttons
                    BoxLayout:
                        orientation: "horizontal"
                        size_hint_x: 0.65
                        padding: [0, 0, 0, 0]  # No padding to ensure symmetry
                        spacing: app.theme_config.get("grid_unit_half", "16dp")
                        
                        # Hours (with buttons +/-)
                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_x: 0.47
                            spacing: "16dp"  # Increased spacing between buttons and digits
                            
                            # Buttons column - NARROWER
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.25
                                
                                ThemedButton:
                                    text: "+"
                                    size_hint_y: 0.5
                                    font_size: "26sp"
                                    on_release: root.increment_hour()
                                
                                ThemedButton:
                                    text: "-"
                                    size_hint_y: 0.5
                                    font_size: "26sp"
                                    on_release: root.decrement_hour()
                            
                            # Hour display
                            ThemedLabel:
                                id: hour_label
                                text: root.alarm_time.split(':')[0]
                                font_size: "110sp"
                                halign: "right"
                                valign: "center"
                                size_hint_x: 0.75
                        
                        # Separator
                        ThemedLabel:
                            text: ":"
                            font_size: "80sp"
                            halign: "center"
                            valign: "center"
                            size_hint_x: 0.04
                        
                        # Minutes (with buttons +/-)
                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_x: 0.47
                            spacing: "0dp"  # No spacing to ensure symmetry
                            
                            # Minute display
                            ThemedLabel:
                                id: minute_label
                                text: root.alarm_time.split(':')[1]
                                font_size: "110sp"
                                halign: "center"
                                valign: "center"
                                size_hint_x: 0.75
                            
                            # Buttons column - NARROWER
                            BoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.25
                                
                                ThemedButton:
                                    text: "+"
                                    size_hint_y: 0.5
                                    font_size: "26sp"
                                    on_release: root.increment_minute()
                                
                                ThemedButton:
                                    text: "-"
                                    size_hint_y: 0.5
                                    font_size: "26sp"
                                    on_release: root.decrement_minute()
        
                    # Active toggle button wrapped in AnchorLayout for perfect centering
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"
                        size_hint_x: 0.2
                        
                        Button:
                            id: active_button
                            text: "ON" if root.alarm_active else "OFF"
                            size_hint_x: 1
                            size_hint_y: None
                            height: "70dp"
                            font_name: app.theme_config.get("font_name", "Minecraftia")
                            font_size: "32sp"
                            color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.alarm_active else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
                            background_normal: app.theme_config.get("button_normal", "atlas://data/images/defaulttheme/button")
                            background_down: app.theme_config.get("button_active", "atlas://data/images/defaulttheme/button_pressed")
                            on_press: app.play_sound("click")
                            on_release: root.on_active_toggled(not root.alarm_active)
            
            # Section 2: Days of week - MADE BUTTONS TALLER AND MORE SQUARE
            BoxLayout:
                orientation: "vertical"
                size_hint: 1, None
                height: "80dp"  # Increased significantly
                padding: [0, "10dp", 0, "10dp"]  # Added padding top and bottom
                
                GridLayout:
                    cols: 7
                    spacing: app.theme_config.get("grid_unit_quarter", "8dp")
                    size_hint: 1, 1
                    
                    ToggleButton:
                        id: repeat_mon
                        text: "Mon"
                        state: "down" if "Mon" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Mon", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_tue
                        text: "Tue"
                        state: "down" if "Tue" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Tue", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_wed
                        text: "Wed"
                        state: "down" if "Wed" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Wed", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_thu
                        text: "Thu"
                        state: "down" if "Thu" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Thu", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_fri
                        text: "Fri"
                        state: "down" if "Fri" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Fri", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_sat
                        text: "Sat"
                        state: "down" if "Sat" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Sat", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    ToggleButton:
                        id: repeat_sun
                        text: "Sun"
                        state: "down" if "Sun" in root.alarm_repeat else "normal"
                        on_state: root.toggle_repeat("Sun", self.state)
                        font_name: app.theme_config.get("font_name", "Minecraftia")
                        font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
    
            # Section 3: Ringtone selection
            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: "60dp"  # Increased
                spacing: app.theme_config.get("grid_unit_half", "16dp")
                padding: [app.theme_config.get("grid_unit_half", "16dp"), 0, 0, 0]
                
                # Label
                ThemedLabel:
                    text: "Ringtone:"
                    font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                    halign: "left"
                    valign: "center"
                    size_hint_x: 0.2
                
                # Spinner
                Spinner:
                    id: ringtone_spinner
                    text: root.selected_ringtone
                    values: root.ringtone_list
                    font_name: app.theme_config.get("font_name", "Minecraftia")
                    font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    size_hint_x: 0.6
                    on_text: root.select_ringtone(self.text)
                
                # Play button
                ToggleButton:
                    id: play_button
                    text: "Play"
                    size_hint_x: 0.2
                    font_name: app.theme_config.get("font_name", "Minecraftia")
                    font_size: app.theme_config.get("font_sizes", {}).get("default", "18sp")
                    on_state: root.toggle_play_ringtone(self.state)
    
            # Section 4 & 5: Combined Fade-in and Save in one row
            BoxLayout:
                orientation: "horizontal"
                size_hint: 1, None
                height: "100dp"  # Increased height for more space
                padding: ["20dp", "15dp", "20dp", "15dp"]  # Added bottom padding
                spacing: "20dp"  # Space between fade-in and save button
                
                # Left side: Fade-in
                AnchorLayout:
                    anchor_x: "left"
                    anchor_y: "center"  # Vertically center the panel
                    size_hint: 0.6, 1
                
                    ThemedPanel:
                        orientation: "horizontal"
                        size_hint: 1, None
                        height: "60dp"  # Increased height
                        padding: ["15dp", "5dp", "15dp", "5dp"]
                        
                        # Fade-in label
                        ThemedLabel:
                            text: "Fade-in volume:"
                            font_size: app.theme_config.get("font_sizes", {}).get("medium", "20sp")
                            halign: "right"
                            valign: "center"
                            size_hint_x: 0.7
                        
                        # Spacing
                        Widget:
                            size_hint_x: 0.02  # Reduced spacing
                        
                        # ON/OFF button instead of checkbox
                        Button:
                            id: fadein_button
                            text: "ON" if root.alarm_fadein else "OFF"
                            size_hint_x: 0.18  # Narrower
                            size_hint_y: 0.8  # Higher
                            pos_hint: {"center_y": 0.6}  # Positioned higher
                            font_name: app.theme_config.get("font_name", "Minecraftia")
                            font_size: "20sp"
                            color: app.theme_config.get("colors", {}).get("active", [0, 1, 0, 1]) if root.alarm_fadein else app.theme_config.get("colors", {}).get("inactive", [0.6, 0.6, 0.6, 1])
                            background_normal: app.theme_config.get("button_normal", "atlas://data/images/defaulttheme/button")
                            background_down: app.theme_config.get("button_active", "atlas://data/images/defaulttheme/button_pressed")
                            on_press: app.play_sound("click")
                            on_release: root.on_fadein_toggled(not root.alarm_fadein)
                
                # Right side: Save button
                AnchorLayout:
                    anchor_x: "right"
                    anchor_y: "center"  # Vertically center the button
                    size_hint: 0.4, 1
                    
                    ThemedButton:
                        text: "Save"
                        font_size: app.theme_config.get("font_sizes", {}).get("large", "24sp")
                        size_hint: 0.9, None  # Takes 90% of the parent width
                        height: "60dp"  # Increased to match fade-in panel
                        on_release: root.save_alarm()