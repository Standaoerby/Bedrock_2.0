<ScheduleScreen>:
    page_key: "schedule"
    FloatLayout:
        size_hint: 1, 1

        ScreenOverlay:
            page_key: "schedule"

        # Today + Tomorrow (visible when not in week mode)
        BoxLayout:
            orientation: "horizontal"
            size_hint: 0.96, 0.84
            pos_hint: {"center_x": 0.5, "top": 0.98}
            padding: app.ui_metrics["padding_xs"]
            spacing: app.ui_metrics["spacing_md"]
            opacity: 1 if not root.week_mode else 0
            # opacity alone doesn't stop touch propagation — disabled
            # ensures the hidden panel doesn't swallow taps meant for
            # the toggle button below.
            disabled: root.week_mode

            # Today (left, larger)
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.6
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_sm"]

                ThemedLabel:
                    text: "Today: %s, %s" % (root.today_date, root.today_day)
                    size_role: "section_title"
                    color_role: "font_highlight"
                    bold: True
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True

                    ThemedLabel:
                        id: today_label
                        text: "..."
                        size_role: "metric_value"
                        color_role: "font_default"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: "left"
                        valign: "top"
                        padding: app.ui_metrics["padding_sm"], 0

            # Tomorrow (right, smaller)
            ThemedPanel:
                orientation: "vertical"
                size_hint_x: 0.4
                padding: app.ui_metrics["padding_md"]
                spacing: app.ui_metrics["spacing_sm"]

                ThemedLabel:
                    text: "Tomorrow: %s, %s" % (root.tomorrow_date, root.tomorrow_day)
                    size_role: "field_label"
                    color_role: "font_secondary"
                    bold: True
                    size_hint_y: None
                    height: app.ui_metrics["widget_height_md"]

                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: True

                    ThemedLabel:
                        id: tomorrow_label
                        text: "..."
                        size_role: "tiny"
                        color_role: "font_default"
                        text_size: self.width, None
                        size_hint_y: None
                        height: self.texture_size[1]
                        halign: "left"
                        valign: "top"
                        padding: app.ui_metrics["padding_sm"], 0

        # Weekly view (visible when week_mode)
        ThemedPanel:
            orientation: "vertical"
            size_hint: 0.96, 0.84
            pos_hint: {"center_x": 0.5, "top": 0.98}
            opacity: 1 if root.week_mode else 0
            disabled: not root.week_mode
            padding: app.ui_metrics["padding_md"]

            GridLayout:
                id: week_grid
                cols: 5
                spacing: app.ui_metrics["spacing_sm"]
                size_hint_y: 1

                # Five day columns. id's are referenced from Python.
                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Monday"
                        size_role: "field_label"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: monday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Tuesday"
                        size_role: "field_label"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: tuesday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Wednesday"
                        size_role: "field_label"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: wednesday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Thursday"
                        size_role: "field_label"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: thursday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

                BoxLayout:
                    orientation: "vertical"
                    ThemedLabel:
                        text: "Friday"
                        size_role: "field_label"
                        color_role: "font_highlight"
                        bold: True
                        size_hint_y: None
                        height: app.ui_metrics["widget_height_sm"]
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: True
                        ThemedLabel:
                            id: friday_label
                            text: ""
                            size_role: "tiny"
                            color_role: "font_default"
                            text_size: self.width, None
                            size_hint_y: None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "top"

        # Toggle button
        ThemedButton:
            id: week_button
            text: "View Weekly Schedule" if not root.week_mode else "Back to Today's Schedule"
            size_role: "field_label"
            color_role: "font_default"
            size_hint: 0.5, None
            height: app.ui_metrics["widget_height_md"]
            pos_hint: {"center_x": 0.5, "center_y": 0.08}
            on_press: app.play_sound("click")
            on_release: root.toggle_week_mode()
