<WeatherScreen>:
    FloatLayout:
        size_hint: 1, 1
        
        # ИСПРАВЛЕНО: Screen overlay с правильным id
        Image:
            id: weather_overlay
            source: app.get_overlay_image("weather")
            allow_stretch: True
            keep_ratio: True
            size_hint: None, None
            width: self.parent.width
            height: self.parent.height
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
        
        BoxLayout:
            orientation: 'vertical'
            padding: "10dp"  # Reduced from 15dp
            spacing: "8dp"   # Reduced from 10dp
            pos_hint: {"center_x": 0.5, "center_y": 0.52}  # Aligned with schedule page
            size_hint: 0.95, 0.9  # Increased from 0.9, 0.8
            
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: 0.4
                spacing: "8dp"  # Reduced from 10dp
                
                # External weather data
                ThemedPanel:
                    orientation: 'vertical'
                    padding: "15dp"
                    spacing: "10dp"
                    size_hint_x: 0.5
                    
                    ThemedLabel:
                        text: "Weather Forecast"
                        font_size: "24sp"
                        size_hint_y: None
                        height: "48dp"
                    
                    BoxLayout:
                        orientation: 'vertical'
                        spacing: "5dp"
                        size_hint_y: 1
                        
                        # Temperature with only white or orange color (no blue)
                        ThemedLabel:
                            id: current_temp
                            text: "0°C"
                            font_size: "42sp"
                            halign: 'left'
                            size_hint_y: 0.5
                            color: [1, 1, 1, 1] if float(self.text.split('°')[0]) < 15 else [1, 0.6, 0, 1]  # White if < 15, orange if >= 15
                        
                        # Condition and Rain on one line 
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: 0.5  # Consolidated space
                            
                            ThemedLabel:
                                id: current_condition
                                text: "Weather condition"
                                font_size: "20sp"
                                halign: 'left'
                                size_hint_x: 0.6
                            
                            ThemedLabel:
                                id: current_precipitation
                                text: "Rain: 0%"
                                font_size: "18sp"
                                halign: 'right'
                                size_hint_x: 0.4
                
                # Internal sensor data
                ThemedPanel:
                    orientation: 'vertical'
                    padding: "15dp"
                    spacing: "10dp"
                    size_hint_x: 0.5
                    
                    # Room Sensors title with ON indicator - only shown for real sensors
                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: "48dp"
                        
                        ThemedLabel:
                            text: "Room Sensors"
                            font_size: "24sp"
                            size_hint_x: 0.7
                            halign: 'left'
                            valign: 'middle'
                        
                        # Sensor connection indicator - only for real sensors
                        ThemedLabel:
                            id: sensor_status
                            text: "ON" if root.sensor_available and not root.using_mock_sensors else ""
                            font_size: "20sp"
                            size_hint_x: 0.3
                            halign: 'right'
                            valign: 'middle'
                            color: [0, 0.8, 0, 1]  # Green color
                    
                    GridLayout:
                        cols: 1
                        spacing: "5dp"
                        
                        ThemedLabel:
                            id: sensor_temp
                            text: "Temperature: 0°C"
                            font_size: "20sp"
                            halign: 'left'
                            text_size: self.width, None
                            padding_x: "15dp"  # Left padding
                        
                        ThemedLabel:
                            id: sensor_humidity
                            text: "Humidity: 0%"
                            font_size: "20sp"
                            halign: 'left'
                            text_size: self.width, None
                            padding_x: "15dp"  # Left padding
                        
                        # CO2 and TVOC in one line
                        ThemedLabel:
                            id: sensor_combined
                            text: "CO2: 0 ppm, TVOC: 0 ppb"  # Combined CO2 and TVOC
                            font_size: "20sp"
                            halign: 'left'
                            text_size: self.width, None
                            padding_x: "15dp"  # Left padding
                        
                        ThemedLabel:
                            id: air_quality
                            text: "Air Quality: Unknown"
                            font_size: "20sp"
                            halign: 'left'
                            text_size: self.width, None
                            padding_x: "15dp"  # Left padding
            
            # Weekly forecast with improved scrolling
            ThemedPanel:
                orientation: 'vertical'
                padding: "15dp"
                spacing: "8dp"  # Reduced from 10dp
                size_hint_y: 0.6
                
                ThemedLabel:
                    text: "Weekly Forecast"
                    font_size: "24sp"
                    size_hint_y: None
                    height: "48dp"
                
                # Background color for scroll area
                BoxLayout:
                    canvas.before:
                        Color:
                            rgba: [0.15, 0.15, 0.15, 0.3]
                        Rectangle:
                            pos: self.pos
                            size: self.size
                    
                    # Improved ScrollView for weekly forecast
                    ScrollView:
                        id: weekly_scroll
                        do_scroll_x: False
                        do_scroll_y: True
                        scroll_type: ['content', 'bars']
                        bar_width: "15dp"
                        bar_color: [0.7, 0.7, 0.7, 0.9]
                        bar_inactive_color: [0.5, 0.5, 0.5, 0.5]
                        effect_cls: "DampedScrollEffect"
                        
                        BoxLayout:
                            id: weekly_forecast_container
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            spacing: "8dp"  # Reduced from 10dp
                            padding: "8dp"  # Reduced from 10dp